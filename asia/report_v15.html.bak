<!-- PAGE 9: METHODOLOGY -->
<div class="page">
  <div class="mini-header">
    <div class="title">Methodology</div>
    <div class="right" style="display: flex; align-items: center; gap: 8px;"><span>__MONTH_LONG__</span></div>
  </div>

  <div style="font-size: 9px; line-height: 1.7; color: #1a1a1a;">

    <div style="font-weight: 700; font-size: 10px; margin-bottom: 8px;">Asia AUM</div>
    <p style="margin: 0 0 8px 0;">Korean retail holdings are sourced directly from the Korea Securities Depository (KSD), while Korean institutional holdings come from publicly available sources. Both are updated monthly. The majority of Japanese brokerage data is received monthly from individual brokers. Other Asian brokerage, intermediary, and market data are received monthly, quarterly, or on an ad-hoc basis. Asia-related investor positions reported in 13F filings are reviewed and updated on a quarterly basis.</p>
    <p style="margin: 0 0 12px 0;">In the event of delayed data, share counts are held constant and AUM is marked-to-market based on the latest month-end NAV. Share counts are updated and back-adjusted once the new data is received.</p>

    <div style="font-weight: 700; font-size: 10px; margin-bottom: 8px;">Global AUM</div>
    <ul style="margin: 0 0 12px 14px; padding: 0; list-style-type: disc;">
      <li>Sourced from Bloomberg as of each month-end</li>
      <li>Covers all REX ETPs across ETFs and ETNs</li>
      <li>Used to calculate each fund's percentage of global AUM held in Asia and to decompose AUM changes into market impact and investor flows</li>
    </ul>

    <div style="font-weight: 700; font-size: 10px; margin-bottom: 8px;">Estimated Flows</div>
    <ul style="margin: 0 0 12px 14px; padding: 0; list-style-type: disc;">
      <li>Each fund's month-over-month Asia AUM change is split into two components: market impact and estimated investor flows</li>
      <li>Market impact is the portion of the change attributable to the fund's global price movement</li>
      <li>Estimated flows are the residual — the AUM change not explained by price movement, representing net new investment or redemptions</li>
      <li>These are estimates. Actual fund flows, where disclosed by managers, may differ</li>
    </ul>

  </div>

  <div class="footer">
    <span>Source: Bloomberg, broker reports, 13F filings. *Flow estimates derived from shares outstanding and NAV data; actual fund flows may differ.</span>
    <span>REX Financial · Page 9</span>
  </div>
</div>


<script>
// Enriched report data — injected by build_reports.js at build time
const REPORT_DATA = null; // INJECTED AT BUILD TIME

// Suite filter: null = full report, 'T-REX' or 'MicroSectors' = suite-only version
const SUITE_FILTER = null;

// ══════════════════════════════════════════════════════════════
// DATA CONSTANTS — computed from REPORT_DATA (enriched JSON)
// Fallback: if REPORT_DATA is null (direct browser open), abort gracefully
// ══════════════════════════════════════════════════════════════
if (!REPORT_DATA) {
  document.body.innerHTML = '<h1 style="padding:40px">Report data not loaded. Run build_reports.js to generate PDFs.</h1>';
  throw new Error('REPORT_DATA not injected');
}

// --- Helpers for family name mapping ---
// DB "Income" family contains EPI, G&I, and Autocallable funds. Report displays them separately.
// ATCL (Autocallable) shows with EPI on suite pages. ULTI (IncomeMax) shows with G&I.
// Both are DB family "Other" or "Income" but grouped with their respective suites for display.
const _EPI_TICKERS = new Set(['FEPI','AIPI','CEPI','ATCL']);
function _displayFamily(dbFamily, ticker) {
  if (dbFamily === 'Income') {
    if (_EPI_TICKERS.has(ticker)) return 'EPI + Autocallable';
    return 'G&I + IncomeMax';
  }
  if (ticker === 'ULTI') return 'G&I + IncomeMax';
  if (ticker === 'ATCL') return 'EPI + Autocallable';
  if (dbFamily === 'REX Osprey') return 'Other';
  return dbFamily;
}

// --- ORIGINAL DATA CONSTANTS (now derived) follow below ---
// ══════════════════════════════════════════════════════════════

// --- Timeline (13 months of total + per-suite AUM) ---
const DATA = (() => {
  const monthEnds = {'01':'31','02':'28','03':'31','04':'30','05':'31','06':'30','07':'31','08':'31','09':'30','10':'31','11':'30','12':'31'};
  return REPORT_DATA.timeline.map(t => {
    const s = t.suites;
    const trex = s['T-REX'] || 0;
    const micro = s['MicroSectors'] || 0;
    const other = (s['Income'] || 0) + (s['Other'] || 0) + (s['REX Osprey'] || 0);
    const parts = t.month.split('-');
    const dd = monthEnds[parts[1]] || '28';
    const month = parts[0] + '-' + parts[1] + '-' + dd;
    return { month, total: t.total, pct: 0, trex, micro, other };
  });
})();
// Fill pct (% of AUM in Asia) from global AUM timeline
// DB only tracks 84 funds; Bloomberg total includes all 93 REX ETPs.
// Scale DB historical global AUM by the current-month ratio to approximate Bloomberg totals.
const _globalTimeline = REPORT_DATA.global_aum_timeline || {};
const _bbgGlobal = REPORT_DATA.headlines.total_global_aum;
const _dbGlobal = REPORT_DATA.headlines.db_global_aum || _bbgGlobal;
const _globalScale = _bbgGlobal / (_dbGlobal || 1);
DATA.forEach((d, i) => {
  const monthKey = REPORT_DATA.timeline[i].month;
  const dbMonthGlobal = _globalTimeline[monthKey] || _dbGlobal;
  const adjustedGlobal = dbMonthGlobal * _globalScale;
  d.pct = d.total / adjustedGlobal;
});

// --- Income sub-timeline (EPI vs G&I split from actual per-fund Asia AUM) ---
const INCOME_TIMELINE = (() => {
  const sgt = REPORT_DATA.suite_global_timeline || [];
  return REPORT_DATA.timeline.map((t, i) => {
    const incomeFunds = sgt[i]?.income_funds || {};
    let epi = 0, gi = 0;
    for (const [ticker, data] of Object.entries(incomeFunds)) {
      const asia = typeof data === 'object' ? (data.asia || 0) : 0;
      if (_EPI_TICKERS.has(ticker)) epi += asia;
      else gi += asia;
    }
    return { month: t.month, epi, gi };
  });
})();

// --- Suite flows (computed from enriched fund data) ---
const SUITE_FLOWS = (() => {
  // Aggregate flows by display family (same grouping as APPENDIX)
  const groups = {};
  REPORT_DATA.funds.forEach(f => {
    if (f.asia_aum <= 0) return;
    const fam = _displayFamily(f.family_name, f.ticker);
    groups[fam] = (groups[fam] || 0) + f.flows;
  });
  return [
    {name: 'T-REX', flows: groups['T-REX'] || 0, color: 'var(--series-1)'},
    {name: 'MicroSectors', flows: groups['MicroSectors'] || 0, color: 'var(--series-2)'},
    {name: 'EPI + Autocallable', flows: groups['EPI + Autocallable'] || 0, color: 'var(--series-3)'},
    {name: 'G&I + IncomeMax', flows: groups['G&I + IncomeMax'] || 0, color: 'var(--series-3)'},
    {name: 'Other', flows: groups['Other'] || 0, color: 'var(--text-muted)'}
  ];
})();

// --- Top fund lists ---
const PI_TOP = REPORT_DATA.funds
  .filter(f => f.family_name === 'Income' && _EPI_TICKERS.has(f.ticker))
  .sort((a, b) => b.asia_aum - a.asia_aum)
  .map(f => ({fund:f.ticker, aum:f.asia_aum, total:f.global_aum, flows:f.flows, mom:f.mom||0, globalMom:f.global_mom||0}));

const GI_TOP = REPORT_DATA.funds
  .filter(f => (f.family_name === 'Income' && !_EPI_TICKERS.has(f.ticker)) || f.ticker === 'ULTI')
  .sort((a, b) => b.asia_aum - a.asia_aum)
  .map(f => ({fund:f.ticker, aum:f.asia_aum, total:f.global_aum, flows:f.flows, mom:f.mom||0, globalMom:f.global_mom||0}));

const OTHER_TOP = REPORT_DATA.funds
  .filter(f => (f.family_name === 'Other' || f.family_name === 'REX Osprey') && f.ticker !== 'ULTI' && f.asia_aum > 0)
  .sort((a, b) => b.asia_aum - a.asia_aum)
  .map(f => ({fund:f.ticker, aum:f.asia_aum, total:f.global_aum, pct:f.pct_of_global, mom:f.mom||0}));

// --- MoM change leaders ---
const TREX_MOM = REPORT_DATA.funds
  .filter(f => f.family_name === 'T-REX' && f.asia_aum > 0)
  .map(f => ({fund: f.ticker, change: f.dollar_change}))
  .sort((a, b) => a.change - b.change);

const MICRO_MOM = REPORT_DATA.funds
  .filter(f => f.family_name === 'MicroSectors' && f.asia_aum > 0)
  .map(f => ({fund: f.ticker, change: f.dollar_change}))
  .sort((a, b) => a.change - b.change);

// --- Country shares (from country_timeline) ---
const COUNTRY_SHARES = REPORT_DATA.country_timeline.map(ct => {
  const total = Object.values(ct.countries).reduce((s, v) => s + v, 0) || 1;
  return {
    korea: (ct.countries['Korea'] || 0) / total,
    hk: (ct.countries['Hong Kong'] || 0) / total,
    japan: (ct.countries['Japan'] || 0) / total,
    other: 1 - ((ct.countries['Korea'] || 0) + (ct.countries['Hong Kong'] || 0) + (ct.countries['Japan'] || 0)) / total
  };
});

// --- Countries (with exact prior from DB) ---
const COUNTRIES = (() => {
  const colors = ['var(--series-1)','var(--negative)','var(--series-2)','var(--series-3)','var(--series-4)','var(--text-muted)','var(--text-secondary)'];
  return REPORT_DATA.countries.map((c, i) => ({
    name: c.country, aum: c.aum, prior: c.aum_prior || 0, color: colors[i] || 'var(--text-muted)'
  }));
})();

// --- Exchanges ---
const EXCHANGES = REPORT_DATA.exchanges.map(e => ({
  name: e.exchange, country: e.country, etps: e.products, aum: e.aum
}));

// --- Top T-REX and MicroSectors funds ---
const TREX_TOP = REPORT_DATA.funds
  .filter(f => f.family_name === 'T-REX' && f.asia_aum > 0)
  .sort((a, b) => b.asia_aum - a.asia_aum)
  .slice(0, 8)
  .map(f => ({fund:f.ticker, aum:f.asia_aum, total:f.global_aum, flows:f.flows, mom:f.mom||0, globalMom:f.global_mom||0}));

const MICRO_TOP = REPORT_DATA.funds
  .filter(f => f.family_name === 'MicroSectors' && f.asia_aum > 0)
  .sort((a, b) => b.asia_aum - a.asia_aum)
  .slice(0, 8)
  .map(f => ({fund:f.ticker, aum:f.asia_aum, total:f.global_aum, flows:f.flows, mom:f.mom||0, globalMom:f.global_mom||0}));

// --- APPENDIX (all funds with display family names) ---
const APPENDIX = REPORT_DATA.funds
  .filter(f => f.asia_aum > 0)
  .map(f => ({
    fund: f.ticker,
    family: _displayFamily(f.family_name, f.ticker),
    aum: f.asia_aum, total: f.global_aum, pct: f.pct_of_global,
    mom: f.mom || 0, flows: f.flows,
    aumPrior: f.asia_aum_prior,
    globalPrior: f.global_aum_prior,
    global: f.global_aum,
    marketMove: f.market_move || 0
  }))
  .sort((a, b) => b.aum - a.aum);

// --- Flow leaders ---
const _allFlows = APPENDIX.filter(f => Math.abs(f.flows) > 100).map(f => ({fund:f.fund, flows:f.flows, family:f.family}));
const LOSERS_10 = [..._allFlows].sort((a, b) => a.flows - b.flows).slice(0, 10);
const GAINERS_10 = [..._allFlows].sort((a, b) => b.flows - a.flows).slice(0, 10);

// --- Product Suite Breakdown (page 1 donut + table) ---
const SUITES = (() => {
  const groups = {};
  REPORT_DATA.funds.forEach(f => {
    if (f.asia_aum <= 0 && f.asia_aum_prior <= 0) return;
    const suite = _displayFamily(f.family_name, f.ticker);
    if (!groups[suite]) groups[suite] = { aum: 0, prior: 0 };
    groups[suite].aum += f.asia_aum;
    groups[suite].prior += f.asia_aum_prior;
  });
  return [
    { name: 'T-REX',              aum: groups['T-REX']?.aum||0,              prior: groups['T-REX']?.prior||0,              color: 'var(--series-1)' },
    { name: 'MicroSectors',       aum: groups['MicroSectors']?.aum||0,       prior: groups['MicroSectors']?.prior||0,       color: 'var(--series-2)' },
    { name: 'EPI + Autocallable', aum: groups['EPI + Autocallable']?.aum||0, prior: groups['EPI + Autocallable']?.prior||0, color: 'var(--series-3)' },
    { name: 'G&I + IncomeMax',    aum: groups['G&I + IncomeMax']?.aum||0,    prior: groups['G&I + IncomeMax']?.prior||0,    color: 'var(--series-4)' },
    { name: 'Other',              aum: groups['Other']?.aum||0,              prior: groups['Other']?.prior||0,              color: 'var(--text-muted)' }
  ];
})();

// --- Per-suite country distribution ---
function _buildSuiteCountry(familyFilter) {
  const m = {};
  REPORT_DATA.fund_countries.forEach(fc => {
    const fund = REPORT_DATA.funds.find(f => f.ticker === fc.ticker);
    if (!fund) return;
    const fam = _displayFamily(fund.family_name, fund.ticker);
    if (!familyFilter(fam, fund.ticker)) return;
    m[fc.country] = (m[fc.country] || 0) + fc.aum;
  });
  const total = Object.values(m).reduce((s, v) => s + v, 0) || 1;
  return Object.entries(m).map(([name, aum]) => ({name, aum:aum/1e6, pct:aum/total*100})).sort((a,b) => b.aum-a.aum);
}
const TREX_COUNTRY_SUMMARY = _buildSuiteCountry(f => f === 'T-REX');
const MICRO_COUNTRY_SUMMARY = _buildSuiteCountry(f => f === 'MicroSectors');
const EPI_COUNTRY_SUMMARY = _buildSuiteCountry(f => f === 'EPI + Autocallable');
const GI_COUNTRY_SUMMARY = _buildSuiteCountry((f, t) => f === 'G&I + IncomeMax' || t === 'ULTI');

// --- Historical country distribution bars (6-month, from DB) ---
function _buildCountry6M(dbSuiteName, countries) {
  const data = REPORT_DATA.suite_country_6m?.[dbSuiteName] || [];
  return data.map(m => {
    const total = Object.values(m.countries).reduce((s, v) => s + v, 0) || 1;
    const pcts = countries.map(c => {
      if (c === 'Other') {
        const named = countries.filter(x => x !== 'Other').reduce((s, x) => s + (m.countries[x] || 0), 0);
        return (total - named) / total * 100;
      }
      return (m.countries[c] || 0) / total * 100;
    });
    return { month: m.month, pcts };
  });
}
const TREX_COUNTRY_6M = _buildCountry6M('T-REX', ['Korea', 'Hong Kong', 'Japan', 'Other']);
const MICRO_COUNTRY_6M = _buildCountry6M('MicroSectors', ['Korea', 'Hong Kong', 'Japan', 'Other']);
// EPI and G&I: DB "Income" family can't be split historically. Use fund_countries for current month only.
function _buildDisplayFamily6M(familyFilter, countries) {
  // Build current-month percentages from fund_countries
  const countryAum = {};
  (REPORT_DATA.fund_countries || []).forEach(fc => {
    const fund = REPORT_DATA.funds.find(f => f.ticker === fc.ticker);
    if (!fund) return;
    const fam = _displayFamily(fund.family_name, fund.ticker);
    if (!familyFilter(fam, fund.ticker)) return;
    countryAum[fc.country] = (countryAum[fc.country] || 0) + fc.aum;
  });
  const total = Object.values(countryAum).reduce((s, v) => s + v, 0) || 1;
  const pcts = countries.map(c => {
    if (c === 'Other') {
      const named = countries.filter(x => x !== 'Other').reduce((s, x) => s + (countryAum[x] || 0), 0);
      return (total - named) / total * 100;
    }
    return (countryAum[c] || 0) / total * 100;
  });
  // Return as single-month array (current month only)
  const lastTimeline = REPORT_DATA.suite_country_6m?.['Income'] || [];
  const lastMonth = lastTimeline.length ? lastTimeline[lastTimeline.length - 1].month : "Feb '26";
  return [{ month: lastMonth, pcts }];
}
// EPI and G&I: use Income family 6-month data (EPI dominates Income, G&I is small)
// Current month uses exact per-fund split; historical months use Income family total
const EPI_COUNTRY_6M = (() => {
  const income6m = _buildCountry6M('Income', ['Japan', 'Korea', 'Hong Kong', 'Other']);
  // Replace last month with exact EPI-only data
  if (income6m.length > 0) {
    const exact = _buildDisplayFamily6M((f) => f === 'EPI + Autocallable', ['Japan', 'Korea', 'Hong Kong', 'Other']);
    if (exact.length > 0) income6m[income6m.length - 1] = exact[0];
  }
  return income6m;
})();
const GI_COUNTRY_6M = (() => {
  const income6m = _buildCountry6M('Income', ['Korea', 'Japan', 'Singapore', 'Other']);
  // Replace last month with exact G&I-only data
  if (income6m.length > 0) {
    const exact = _buildDisplayFamily6M((f, t) => f === 'G&I + IncomeMax', ['Korea', 'Japan', 'Singapore', 'Other']);
    if (exact.length > 0) income6m[income6m.length - 1] = exact[0];
  }
  return income6m;
})();

// --- % of global AUM in Asia per suite (dashed line in family timelines) ---
// Uses per-suite per-month global AUM from DB (each month's actual denominator)
const _sgt = REPORT_DATA.suite_global_timeline || [];
function _suiteGlobalForMonth(suiteName, monthIdx) {
  if (monthIdx < _sgt.length) return _sgt[monthIdx]?.suites?.[suiteName] || 0;
  return 0;
}
const TREX_PCT = DATA.map((d, i) => {
  const g = _suiteGlobalForMonth('T-REX', i);
  return g ? Math.round(d.trex / g * 100) : 0;
});
const MICRO_PCT = DATA.map((d, i) => {
  const g = _suiteGlobalForMonth('MicroSectors', i);
  return g ? Math.round(d.micro / g * 100) : 0;
});
// EPI and G&I need per-fund global AUM split (not the combined Income family)
function _epiGiGlobalForMonth(monthIdx) {
  if (monthIdx >= _sgt.length) return { epi: 0, gi: 0 };
  const incomeFunds = _sgt[monthIdx]?.income_funds || {};
  let epiGlobal = 0, giGlobal = 0;
  for (const [ticker, data] of Object.entries(incomeFunds)) {
    const globalAum = typeof data === 'object' ? (data.global || 0) : data;
    if (_EPI_TICKERS.has(ticker)) epiGlobal += globalAum;
    else giGlobal += globalAum;
  }
  return { epi: epiGlobal, gi: giGlobal };
}
const EPI_PCT = INCOME_TIMELINE.map((t, i) => {
  const g = _epiGiGlobalForMonth(i).epi;
  return g && t.epi ? Math.round(t.epi / g * 100) : 0;
});
const GI_PCT = INCOME_TIMELINE.map((t, i) => {
  const g = _epiGiGlobalForMonth(i).gi;
  return g && t.gi ? Math.round(t.gi / g * 100) : 0;
});


// ══════════════════════════════════════════════════════════════
// UTILITY FUNCTIONS
// ══════════════════════════════════════════════════════════════

function svgEl(tag, attrs) {
  const el = document.createElementNS('http://www.w3.org/2000/svg', tag);
  for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
  return el;
}

// Resolve CSS custom property to hex for SVG attributes
function resolveColor(c) {
  if (!c || !c.startsWith('var(')) return c;
  const prop = c.replace('var(','').replace(')','');
  return getComputedStyle(document.documentElement).getPropertyValue(prop).trim();
}

const FONT = 'Times New Roman, serif';
const MONTHS_SHORT = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function monthLabel(iso) {
  const d = new Date(iso + 'T00:00:00');
  return MONTHS_SHORT[d.getMonth()] + " \u2019" + String(d.getFullYear()).slice(2);
}

function fmtM(v) { const m = Math.round(v / 1e6); return '$' + m.toLocaleString() + 'M'; }
function fmtDollar(v) {
  const abs = Math.abs(v);
  const sign = v < 0 ? '-' : '';
  if (abs >= 1e9) return sign + '$' + (abs/1e9).toFixed(1) + 'B';
  if (abs >= 100e6) return sign + '$' + Math.round(abs/1e6).toLocaleString() + 'M';
  if (abs >= 1e6) return sign + '$' + (abs/1e6).toFixed(1) + 'M';
  if (abs >= 1e3) return sign + '$' + Math.round(abs/1e3).toLocaleString() + 'K';
  return sign + '$0';
}
function fmtPct(v) { return (v * 100).toFixed(1) + '%'; }
function momClass(v) { return v >= 0 ? 'pos-val' : 'neg-val'; }
function momSign(v) { return v >= 0 ? '+' : ''; }


// ══════════════════════════════════════════════════════════════
// CHART BUILDERS
// ══════════════════════════════════════════════════════════════

// --- Chart: Asia AUM by Product Suite (Stacked Area) ---
function buildSuiteStackedArea(colors) {
  const container = document.getElementById('chart-suite-stacked');
  const rect = container.getBoundingClientRect();
  const viewW = Math.round(rect.width);
  const viewH = Math.round(rect.height);
  if (viewW < 10 || viewH < 10) return;
  const svg = svgEl('svg', { viewBox: `0 0 ${viewW} ${viewH}`, preserveAspectRatio: 'none', width: '100%', height: '100%' });

  const L = 38, R = viewW - 24, T = 10, B = viewH - 18;
  const W = R - L, H = B - T, n = DATA.length;
  const _maxSuite = Math.max(...DATA.map(d => (d.trex + d.micro + d.other) / 1e6));
  const yMax = Math.ceil(_maxSuite / 500) * 500;
  const valToY = v => T + H - (v / yMax) * H;
  const idxToX = i => L + (i / (n - 1)) * W;

  // Grid lines (solid) — skip $0M label to avoid overlap with X-axis
  for (let v = 0; v <= yMax; v += 500) {
    const y = valToY(v);
    svg.appendChild(svgEl('line', { x1: L, y1: y, x2: R, y2: y, stroke: colors.grid, 'stroke-width': '0.5' }));
    if (v > 0) {
      svg.appendChild(svgEl('text', { x: L - 4, y: y + 3, 'text-anchor': 'end', fill: colors.muted, 'font-size': '8', 'font-family': FONT })).textContent = '$' + v.toLocaleString() + 'M';
    }
  }

  // X-axis labels
  DATA.forEach((d, i) => {
    if (i % 3 === 0 || i === n - 1) {
      svg.appendChild(svgEl('text', { x: idxToX(i), y: B + 11, 'text-anchor': 'middle', fill: colors.muted, 'font-size': '8', 'font-family': FONT })).textContent = monthLabel(d.month);
    }
  });

  const layers = [
    { key: 'trex', color: colors.series1, fillOpacity: '0.18' },
    { key: 'micro', color: colors.series2, fillOpacity: '0.18' },
    { key: 'other', color: colors.series3, fillOpacity: '0.15' }
  ];
  const stacks = DATA.map(d => {
    const t = d.trex / 1e6, m = d.micro / 1e6, o = d.other / 1e6;
    return [t, t + m, t + m + o];
  });

  for (let li = layers.length - 1; li >= 0; li--) {
    const bottomVal = li === 0 ? DATA.map(() => 0) : stacks.map(s => s[li - 1]);
    const topVal = stacks.map(s => s[li]);
    let pts = '';
    for (let i = 0; i < n; i++) pts += `${idxToX(i)},${valToY(topVal[i])} `;
    for (let i = n - 1; i >= 0; i--) pts += `${idxToX(i)},${valToY(bottomVal[i])} `;
    svg.appendChild(svgEl('polygon', { points: pts, fill: layers[li].color, opacity: layers[li].fillOpacity }));
    let linePts = '';
    for (let i = 0; i < n; i++) linePts += `${idxToX(i)},${valToY(topVal[i])} `;
    svg.appendChild(svgEl('polyline', { points: linePts, fill: 'none', stroke: layers[li].color, 'stroke-width': '2', 'stroke-linejoin': 'round' }));
  }

  // End annotation — dot first, then deferred labels
  const endTotal = stacks[n - 1][stacks[n - 1].length - 1];
  svg.appendChild(svgEl('circle', { cx: idxToX(n-1), cy: valToY(endTotal), r: 2.5, fill: colors.series1 }));

  // Deferred labels: collect all label elements, append LAST
  const labels = [];
  const endText = '$' + Math.round(endTotal).toLocaleString() + 'M';
  const endLabelX = idxToX(n - 1);
  const endLabelY = valToY(endTotal) - 6;
  const endEstW = endText.length * 5 + 8;
  labels.push(svgEl('rect', { x: endLabelX - endEstW, y: endLabelY - 10, width: endEstW, height: 14, fill: '#ffffff', opacity: '0.90', rx: 2 }));
  const endEl = svgEl('text', { x: endLabelX, y: endLabelY, 'text-anchor': 'end', fill: colors.series1, 'font-size': '10', 'font-weight': '700', 'font-family': FONT });
  endEl.textContent = endText;
  labels.push(endEl);

  labels.forEach(el => svg.appendChild(el));
  container.appendChild(svg);
}

// --- Chart: % of AUM in Asia ---
function buildPctLineChart(colors) {
  const container = document.getElementById('chart-pct-line');
  const rect = container.getBoundingClientRect();
  const viewW = Math.round(rect.width);
  const viewH = Math.round(rect.height);
  if (viewW < 10 || viewH < 10) return;
  const svg = svgEl('svg', { viewBox: `0 0 ${viewW} ${viewH}`, preserveAspectRatio: 'none', width: '100%', height: '100%' });

  const L = 30, R = viewW - 26, T = 14, B = viewH - 18;
  const W = R - L, H = B - T, n = DATA.length;
  const yMin = 0, yMax = 25;
  const valToY = v => T + H - ((v - yMin) / (yMax - yMin)) * H;
  const idxToX = i => L + (i / (n - 1)) * W;

  // Skip 0% label to avoid overlap with X-axis
  for (let v = 0; v <= yMax; v += 5) {
    const y = valToY(v);
    svg.appendChild(svgEl('line', { x1: L, y1: y, x2: R, y2: y, stroke: colors.grid, 'stroke-width': '0.5' }));
    if (v > 0) {
      svg.appendChild(svgEl('text', { x: L - 4, y: y + 3, 'text-anchor': 'end', fill: colors.muted, 'font-size': '8', 'font-family': FONT })).textContent = v + '%';
    }
  }

  DATA.forEach((d, i) => {
    if (i % 3 === 0 || i === n - 1) {
      svg.appendChild(svgEl('text', { x: idxToX(i), y: B + 11, 'text-anchor': 'middle', fill: colors.muted, 'font-size': '8', 'font-family': FONT })).textContent = monthLabel(d.month);
    }
  });

  const pctVals = DATA.map(d => d.pct * 100);

  // Area fill
  let areaPts = '';
  for (let i = 0; i < n; i++) areaPts += `${idxToX(i)},${valToY(pctVals[i])} `;
  areaPts += `${idxToX(n-1)},${valToY(0)} ${idxToX(0)},${valToY(0)}`;
  svg.appendChild(svgEl('polygon', { points: areaPts, fill: colors.primary, opacity: '0.06' }));

  // Line
  let linePts = '';
  for (let i = 0; i < n; i++) linePts += `${idxToX(i)},${valToY(pctVals[i])} `;
  svg.appendChild(svgEl('polyline', { points: linePts, fill: 'none', stroke: colors.primary, 'stroke-width': '2', 'stroke-linejoin': 'round' }));

  // Endpoint dots
  [0, n-1].forEach(i => {
    svg.appendChild(svgEl('circle', { cx: idxToX(i), cy: valToY(pctVals[i]), r: 2.5, fill: colors.primary }));
  });

  // Min/max dots (render dots before labels)
  const minIdx = pctVals.indexOf(Math.min(...pctVals));
  const maxIdx = pctVals.indexOf(Math.max(...pctVals));
  if (minIdx !== 0 && minIdx !== n-1) {
    svg.appendChild(svgEl('circle', { cx: idxToX(minIdx), cy: valToY(pctVals[minIdx]), r: 2.5, fill: colors.primary }));
  }
  if (maxIdx !== 0 && maxIdx !== n-1 && maxIdx !== minIdx) {
    svg.appendChild(svgEl('circle', { cx: idxToX(maxIdx), cy: valToY(pctVals[maxIdx]), r: 2.5, fill: colors.primary }));
  }

  // Deferred labels: collect all label elements, append LAST
  const labels = [];
  function addPctLabel(x, y, anchor, text) {
    const estW = text.length * 5 + 8;
    const bgX = anchor === 'middle' ? x - estW / 2 : (anchor === 'end' ? x - estW : x);
    labels.push(svgEl('rect', { x: bgX, y: y - 10, width: estW, height: 14, fill: '#ffffff', opacity: '0.90', rx: 2 }));
    const el = svgEl('text', { x: x, y: y, 'text-anchor': anchor, fill: colors.primary, 'font-size': '10', 'font-weight': '700', 'font-family': FONT });
    el.textContent = text;
    labels.push(el);
  }

  // Labels at first and last (endpoint values — font-size 10)
  addPctLabel(idxToX(0) + 4, valToY(pctVals[0]) - 7, 'start', pctVals[0].toFixed(1) + '%');
  addPctLabel(idxToX(n-1) - 4, valToY(pctVals[n-1]) - 7, 'end', pctVals[n-1].toFixed(1) + '%');

  // Min/max labels if different from endpoints
  if (minIdx !== 0 && minIdx !== n-1) {
    addPctLabel(idxToX(minIdx), valToY(pctVals[minIdx]) + 14, 'middle', pctVals[minIdx].toFixed(1) + '%');
  }
  if (maxIdx !== 0 && maxIdx !== n-1 && maxIdx !== minIdx) {
    addPctLabel(idxToX(maxIdx), valToY(pctVals[maxIdx]) - 7, 'middle', pctVals[maxIdx].toFixed(1) + '%');
  }

  labels.forEach(el => svg.appendChild(el));
  container.appendChild(svg);
}

// --- Country Table ---
function buildCountryTable() {
  const body = document.getElementById('country-table-body');
  const total = COUNTRIES.reduce((s, c) => s + c.aum, 0);
  COUNTRIES.forEach(c => {
    const chg = c.aum - c.prior;
    const chgPrefix = chg > 0 ? '+' : chg < 0 ? '-' : '';
    const chgStr = chgPrefix + fmtDollar(Math.abs(chg));
    const tr = document.createElement('tr');
    tr.innerHTML = `<td class="bold"><span style="display:inline-block;width:7px;height:7px;border-radius:1px;background:${resolveColor(c.color)};margin-right:5px;vertical-align:middle;"></span>${c.name}</td><td class="r">${fmtDollar(c.aum)}</td>` +
      `<td class="r">${(c.aum/total*100).toFixed(1)}%</td>` +
      `<td class="r"><span class="${momClass(chg)}">${chgStr}</span></td>`;
    body.appendChild(tr);
  });
  const totalPrior = COUNTRIES.reduce((s, c) => s + c.prior, 0);
  const totalChg = total - totalPrior;
  const totalChgPrefix = totalChg > 0 ? '+' : totalChg < 0 ? '-' : '';
  const totalChgStr = totalChgPrefix + fmtDollar(Math.abs(totalChg));
  const tr = document.createElement('tr');
  tr.className = 'total-row';
  tr.innerHTML = `<td>Total</td><td class="r">${fmtDollar(total)}</td><td class="r">100.0%</td>` +
    `<td class="r"><span class="${momClass(totalChg)}">${totalChgStr}</span></td>`;
  body.appendChild(tr);
}

// --- Country Donut (page 1 only) ---
function buildDonutChart(colors) {
  const container = document.getElementById('chart-donut');
  const size = 164;
  const svg = svgEl('svg', { viewBox: `0 0 ${size} ${size}`, preserveAspectRatio: 'xMidYMid meet', width: '100%', height: '100%' });

  const cx = size / 2, cy = size / 2, r1 = 68, r2 = 47;
  const total = COUNTRIES.reduce((s, c) => s + c.aum, 0);
  let angle = -Math.PI / 2;

  COUNTRIES.forEach(c => {
    const sweep = (c.aum / total) * 2 * Math.PI;
    if (sweep < 0.01) return;
    const a1 = angle, a2 = angle + sweep;
    const large = sweep > Math.PI ? 1 : 0;
    const x1o = cx + r1 * Math.cos(a1), y1o = cy + r1 * Math.sin(a1);
    const x2o = cx + r1 * Math.cos(a2), y2o = cy + r1 * Math.sin(a2);
    const x1i = cx + r2 * Math.cos(a2), y1i = cy + r2 * Math.sin(a2);
    const x2i = cx + r2 * Math.cos(a1), y2i = cy + r2 * Math.sin(a1);
    const d = `M${x1o},${y1o} A${r1},${r1} 0 ${large} 1 ${x2o},${y2o} L${x1i},${y1i} A${r2},${r2} 0 ${large} 0 ${x2i},${y2i} Z`;
    svg.appendChild(svgEl('path', { d, fill: resolveColor(c.color), opacity: '0.88', stroke: '#ffffff', 'stroke-width': '1.5' }));
    angle = a2;
  });

  const countryTotalStr = '$' + Math.round(total / 1e6).toLocaleString() + 'M';
  svg.appendChild(svgEl('text', { x: cx, y: cy - 2, 'text-anchor': 'middle', fill: colors.primary, 'font-size': '13', 'font-weight': '700', 'font-family': FONT })).textContent = countryTotalStr;
  svg.appendChild(svgEl('text', { x: cx, y: cy + 10, 'text-anchor': 'middle', fill: colors.muted, 'font-size': '8', 'font-family': FONT })).textContent = 'Total Asia AUM';

  container.appendChild(svg);
}

// --- Product Suite Donut (page 1) ---
function buildSuiteDonut(colors) {
  const container = document.getElementById('chart-suite-donut');
  if (!container) return;
  const size = 164;
  const svg = svgEl('svg', { viewBox: `0 0 ${size} ${size}`, preserveAspectRatio: 'xMidYMid meet', width: '100%', height: '100%' });

  const cx = size / 2, cy = size / 2, r1 = 68, r2 = 47;
  const total = SUITES.reduce((s, c) => s + c.aum, 0);
  let angle = -Math.PI / 2;

  SUITES.forEach(c => {
    const sweep = (c.aum / total) * 2 * Math.PI;
    if (sweep < 0.01) return;
    const a1 = angle, a2 = angle + sweep;
    const large = sweep > Math.PI ? 1 : 0;
    const x1o = cx + r1 * Math.cos(a1), y1o = cy + r1 * Math.sin(a1);
    const x2o = cx + r1 * Math.cos(a2), y2o = cy + r1 * Math.sin(a2);
    const x1i = cx + r2 * Math.cos(a2), y1i = cy + r2 * Math.sin(a2);
    const x2i = cx + r2 * Math.cos(a1), y2i = cy + r2 * Math.sin(a1);
    const d = `M${x1o},${y1o} A${r1},${r1} 0 ${large} 1 ${x2o},${y2o} L${x1i},${y1i} A${r2},${r2} 0 ${large} 0 ${x2i},${y2i} Z`;
    svg.appendChild(svgEl('path', { d, fill: resolveColor(c.color), opacity: '0.88', stroke: '#ffffff', 'stroke-width': '1.5' }));
    angle = a2;
  });

  const totalStr = '$' + Math.round(total / 1e6).toLocaleString() + 'M';
  svg.appendChild(svgEl('text', { x: cx, y: cy - 2, 'text-anchor': 'middle', fill: colors.primary, 'font-size': '13', 'font-weight': '700', 'font-family': FONT })).textContent = totalStr;
  svg.appendChild(svgEl('text', { x: cx, y: cy + 10, 'text-anchor': 'middle', fill: colors.muted, 'font-size': '8', 'font-family': FONT })).textContent = 'Total Asia AUM';

  container.appendChild(svg);
}

// --- Product Suite Table ---
function buildSuiteTable() {
  const body = document.getElementById('suite-table-body');
  if (!body) return;
  const total = SUITES.reduce((s, c) => s + c.aum, 0);
  SUITES.forEach(c => {
    const chg = c.aum - c.prior;
    const chgPrefix = chg > 0 ? '+' : chg < 0 ? '-' : '';
    const chgStr = chgPrefix + fmtDollar(Math.abs(chg));
    const tr = document.createElement('tr');
    tr.innerHTML = `<td class="bold"><span style="display:inline-block;width:7px;height:7px;border-radius:1px;background:${resolveColor(c.color)};margin-right:5px;vertical-align:middle;"></span>${c.name}</td><td class="r">${fmtDollar(c.aum)}</td>` +
      `<td class="r">${(c.aum/total*100).toFixed(1)}%</td>` +
      `<td class="r"><span class="${momClass(chg)}">${chgStr}</span></td>`;
    body.appendChild(tr);
  });
  // Use exact prior from enriched data
  const totalPrior = REPORT_DATA.headlines.total_asia_aum_prior;
  const totalChg = total - totalPrior;
  const totalChgPrefix = totalChg > 0 ? '+' : totalChg < 0 ? '-' : '';
  const totalChgStr = totalChgPrefix + fmtDollar(Math.abs(totalChg));
  const tr = document.createElement('tr');
  tr.className = 'total-row';
  tr.innerHTML = `<td>Total</td><td class="r">${fmtDollar(total)}</td><td class="r">100.0%</td>` +
    `<td class="r"><span class="${momClass(totalChg)}">${totalChgStr}</span></td>`;
  body.appendChild(tr);
}

// --- Country AUM Over Time (Stacked Area) ---
function buildCountryStackedArea(colors) {
  const container = document.getElementById('chart-country-stacked');
  const rect = container.getBoundingClientRect();
  const viewW = Math.round(rect.width);
  const viewH = Math.round(rect.height);
  if (viewW < 10 || viewH < 10) return;
  const svg = svgEl('svg', { viewBox: `0 0 ${viewW} ${viewH}`, preserveAspectRatio: 'none', width: '100%', height: '100%' });

  const L = 42, R = viewW - 70, T = 10, B = viewH - 16;
  const W = R - L, H = B - T, n = DATA.length;
  const _maxCountry = Math.max(...DATA.map(d => d.total / 1e6));
  const yMax = Math.ceil(_maxCountry / 500) * 500;
  const valToY = v => T + H - (v / yMax) * H;
  const idxToX = i => L + (i / (n - 1)) * W;

  const koreaVals = DATA.map((d, i) => (COUNTRY_SHARES[i].korea * d.total) / 1e6);
  const hkVals = DATA.map((d, i) => (COUNTRY_SHARES[i].hk * d.total) / 1e6);
  const japanVals = DATA.map((d, i) => (COUNTRY_SHARES[i].japan * d.total) / 1e6);
  const otherVals = DATA.map((d, i) => {
    return d.total / 1e6 - koreaVals[i] - hkVals[i] - japanVals[i];
  });

  const stackedLayers = [
    { vals: koreaVals, color: colors.series1 },
    { vals: hkVals, color: colors.negative },
    { vals: japanVals, color: colors.series2 },
    { vals: otherVals, color: colors.muted }
  ];

  const cumStacks = DATA.map((d, i) => {
    const k = koreaVals[i], h = hkVals[i], j = japanVals[i], o = otherVals[i];
    return [k, k + h, k + h + j, k + h + j + o];
  });

  // Skip $0M label to avoid overlap with X-axis
  for (let v = 0; v <= yMax; v += 500) {
    const y = valToY(v);
    svg.appendChild(svgEl('line', { x1: L, y1: y, x2: R, y2: y, stroke: colors.grid, 'stroke-width': '0.5' }));
    if (v > 0) {
      svg.appendChild(svgEl('text', { x: L - 4, y: y + 3, 'text-anchor': 'end', fill: colors.muted, 'font-size': '8', 'font-family': FONT })).textContent = '$' + v.toLocaleString() + 'M';
    }
  }

  DATA.forEach((d, i) => {
    if (i % 3 === 0 || i === n - 1) {
      svg.appendChild(svgEl('text', { x: idxToX(i), y: B + 11, 'text-anchor': 'middle', fill: colors.muted, 'font-size': '8', 'font-family': FONT })).textContent = monthLabel(d.month);
    }
  });

  const fillOpacities = ['0.20', '0.18', '0.15', '0.10'];
  for (let li = stackedLayers.length - 1; li >= 0; li--) {
    const bottomVal = li === 0 ? DATA.map(() => 0) : cumStacks.map(s => s[li - 1]);
    const topVal = cumStacks.map(s => s[li]);
    let pts = '';
    for (let i = 0; i < n; i++) pts += `${idxToX(i)},${valToY(topVal[i])} `;
    for (let i = n - 1; i >= 0; i--) pts += `${idxToX(i)},${valToY(bottomVal[i])} `;
    svg.appendChild(svgEl('polygon', { points: pts, fill: stackedLayers[li].color, opacity: fillOpacities[li] }));
    let linePts = '';
    for (let i = 0; i < n; i++) linePts += `${idxToX(i)},${valToY(topVal[i])} `;
    svg.appendChild(svgEl('polyline', { points: linePts, fill: 'none', stroke: stackedLayers[li].color, 'stroke-width': '2', 'stroke-linejoin': 'round', opacity: '0.8' }));
  }

  // Dots at data points (render before labels)
  const totalVals = cumStacks.map(s => s[s.length - 1]);

  // Deferred labels: collect all label elements, append LAST
  const labels = [];
  function addCountryLabel(x, y, anchor, text, labelColor, fontSize) {
    const estW = text.length * 5 + 8;
    const bgX = anchor === 'middle' ? x - estW / 2 : (anchor === 'end' ? x - estW : x);
    labels.push(svgEl('rect', { x: bgX, y: y - 10, width: estW, height: 14, fill: '#ffffff', opacity: '0.90', rx: 2 }));
    const el = svgEl('text', { x: x, y: y, 'text-anchor': anchor, fill: labelColor, 'font-size': String(fontSize), 'font-weight': '700', 'font-family': FONT });
    el.textContent = text;
    labels.push(el);
  }

  // Compute Y-axis gridline positions for collision check
  const countryGridYs = [];
  for (let v = 0; v <= yMax; v += 500) {
    if (v > 0) countryGridYs.push(valToY(v));
  }

  // Monthly total callouts at every data point (above top of stack) — ALL identical style
  for (let i = 0; i < n; i++) {
    if (i === n - 1) continue; // last index gets end-value label instead
    const cx = idxToX(i);
    let cy = valToY(totalVals[i]) - 12;
    // Clamp if above top margin
    if (cy < T) cy = T + 4;
    // Offset UP if too close to a Y-axis gridline
    const nearGrid = countryGridYs.some(gy => Math.abs(valToY(totalVals[i]) - gy) < 18);
    if (nearGrid) {
      cy = cy - 15;
      if (cy < T) cy = T + 4;
    }
    const labelText = '$' + Math.round(totalVals[i]).toLocaleString() + 'M';
    // Small dot marker at top of stack
    svg.appendChild(svgEl('circle', { cx: cx, cy: valToY(totalVals[i]), r: 1.5, fill: colors.series1 }));
    addCountryLabel(cx, cy, 'middle', labelText, colors.series1, 8);
  }

  // Total value at right end of chart (top of stack)
  const endIdx = n - 1;
  const totalEndVal = cumStacks[endIdx][cumStacks[endIdx].length - 1];
  const totalEndText = '$' + Math.round(totalEndVal).toLocaleString() + 'M';
  addCountryLabel(idxToX(endIdx) + 4, valToY(totalEndVal) - 6, 'start', totalEndText, colors.series1, 9);

  // End annotations — country names + values at right edge
  const koreaEndVal = Math.round(koreaVals[endIdx]);
  const hkEndVal = Math.round(hkVals[endIdx]);
  const japanEndVal = Math.round(japanVals[endIdx]);

  const labelX = R + 6;
  const labelData = [
    { text: 'Korea $' + koreaEndVal.toLocaleString() + 'M', y: valToY(cumStacks[endIdx][0] / 2) + 3, color: colors.series1 },
    { text: 'HK $' + hkEndVal.toLocaleString() + 'M', y: valToY(cumStacks[endIdx][0] + hkVals[endIdx] / 2) + 3, color: colors.negative },
    { text: 'Japan $' + japanEndVal.toLocaleString() + 'M', y: valToY(cumStacks[endIdx][1] + japanVals[endIdx] / 2) + 3, color: colors.series2 }
  ];

  labelData.sort((a, b) => a.y - b.y);
  for (let i = 1; i < labelData.length; i++) {
    if (labelData[i].y - labelData[i-1].y < 10) {
      labelData[i].y = labelData[i-1].y + 10;
    }
  }

  labelData.forEach(lbl => {
    addCountryLabel(labelX, lbl.y, 'start', lbl.text, lbl.color, 9);
  });

  labels.forEach(el => svg.appendChild(el));
  container.appendChild(svg);
}

// --- Exchange Table ---
function buildExchangeTable() {
  const body = document.getElementById('exchange-table-body');
  const total = EXCHANGES.reduce((s, e) => s + e.aum, 0);
  const top10 = EXCHANGES.slice(0, 10);
  const others = EXCHANGES.slice(10);

  top10.forEach(e => {
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${e.name}</td><td>${e.country}</td><td class="r">${e.etps}</td>` +
      `<td class="r">${fmtDollar(e.aum)}</td><td class="r">${(e.aum/total*100).toFixed(1)}%</td>`;
    body.appendChild(tr);
  });

  const othersAum = others.reduce((s, e) => s + e.aum, 0);
  // Unique products across all "others" exchanges
  const othersUniqueEtps = others.reduce((s, e) => s + e.etps, 0);
  const tr = document.createElement('tr');
  tr.style.fontStyle = 'italic';
  tr.style.color = 'var(--text-muted)';
  tr.innerHTML = `<td>Others (${others.length})</td><td>Various</td><td class="r">${othersUniqueEtps}</td>` +
    `<td class="r">${fmtDollar(othersAum)}</td><td class="r">${(othersAum/total*100).toFixed(1)}%</td>`;
  body.appendChild(tr);

  const trTotal = document.createElement('tr');
  trTotal.className = 'total-row';
  const totalExchanges = EXCHANGES.length;
  const uniqueMarkets = [...new Set(EXCHANGES.map(e => e.country))].length;
  const totalProducts = REPORT_DATA.headlines.fund_count;
  trTotal.innerHTML = `<td>Total (${totalExchanges} Exchanges)</td><td>${uniqueMarkets} Markets</td><td class="r">${totalProducts}</td>` +
    `<td class="r">${fmtDollar(total)}</td><td class="r">100.0%</td>`;
  body.appendChild(trTotal);
}

// --- Flow Leader Outflows Chart (left chart — bars extend LEFT from tickers) ---
function buildFlowOutflows(colors) {
  const container = document.getElementById('chart-flow-outflows');
  if (!container) return;
  const rect = container.getBoundingClientRect();
  const viewW = Math.round(rect.width);
  const viewH = Math.round(rect.height);
  if (viewW < 10 || viewH < 10) return;
  const svg = svgEl('svg', { viewBox: `0 0 ${viewW} ${viewH}`, preserveAspectRatio: 'none', width: '100%', height: '100%' });

  // Sort by most negative first (highest absolute outflow at top)
  const sorted = [...LOSERS_10].sort((a, b) => a.flows - b.flows);
  const maxFlow = Math.max(...sorted.map(f => Math.abs(f.flows)));
  const T = 4, barH = Math.min(14, Math.floor((viewH - T - 4) / sorted.length) - 3), gap = 3;
  const tickerX = viewW - 6; // Tickers on right side
  const barRightEdge = viewW - 52; // Bars end here (left of ticker)
  const barMaxW = barRightEdge - 40; // Max bar width, leaving room for value labels

  sorted.forEach((f, i) => {
    const y = T + i * (barH + gap);
    const barW = (Math.abs(f.flows) / maxFlow) * barMaxW;
    const barX = barRightEdge - barW;

    svg.appendChild(svgEl('rect', { x: barX, y: y, width: Math.max(barW, 2), height: barH, rx: 0, fill: colors.negative, opacity: '0.80' }));
    // Ticker on right side — right-aligned so text extends LEFT (not past SVG edge)
    const tickerLabel = svg.appendChild(svgEl('text', { x: tickerX, y: y + barH / 2 + 3, 'text-anchor': 'end', fill: colors.textPrimary, 'font-size': '8.5', 'font-weight': '600', 'font-family': FONT }));
    tickerLabel.textContent = String(f.fund);
    // Value label at left end of bar
    svg.appendChild(svgEl('text', { x: barX - 3, y: y + barH / 2 + 3, 'text-anchor': 'end', fill: colors.negative, 'font-size': '7.5', 'font-weight': '600', 'font-family': FONT })).textContent = fmtDollar(f.flows);
  });

  container.appendChild(svg);
}

// --- Flow Leader Inflows Chart (right chart — bars extend RIGHT from tickers) ---
function buildFlowInflows(colors) {
  const container = document.getElementById('chart-flow-inflows');
  if (!container) return;
  const rect = container.getBoundingClientRect();
  const viewW = Math.round(rect.width);
  const viewH = Math.round(rect.height);
  if (viewW < 10 || viewH < 10) return;
  const svg = svgEl('svg', { viewBox: `0 0 ${viewW} ${viewH}`, preserveAspectRatio: 'none', width: '100%', height: '100%' });

  // Sort by highest positive first (highest inflow at top)
  const sorted = [...GAINERS_10].sort((a, b) => b.flows - a.flows);
  const maxFlow = Math.max(...sorted.map(f => Math.abs(f.flows)));
  const T = 4, barH = Math.min(14, Math.floor((viewH - T - 4) / sorted.length) - 3), gap = 3;
  const tickerX = 10; // Tickers on left side
  const barLeftEdge = 50; // Bars start here (right of ticker)
  const barMaxW = viewW - barLeftEdge - 40; // Max bar width, leaving room for value labels

  sorted.forEach((f, i) => {
    const y = T + i * (barH + gap);
    const barW = (Math.abs(f.flows) / maxFlow) * barMaxW;

    svg.appendChild(svgEl('rect', { x: barLeftEdge, y: y, width: Math.max(barW, 2), height: barH, rx: 0, fill: colors.positive, opacity: '0.80' }));
    // Ticker on left side — explicitly use f.fund
    const tickerLabel = svg.appendChild(svgEl('text', { x: tickerX, y: y + barH / 2 + 3, 'text-anchor': 'start', fill: colors.textPrimary, 'font-size': '8.5', 'font-weight': '600', 'font-family': FONT }));
    tickerLabel.textContent = String(f.fund);
    // Value label at right end of bar
    svg.appendChild(svgEl('text', { x: barLeftEdge + barW + 3, y: y + barH / 2 + 3, 'text-anchor': 'start', fill: colors.positive, 'font-size': '7.5', 'font-weight': '600', 'font-family': FONT })).textContent = '+' + fmtDollar(f.flows);
  });

  container.appendChild(svg);
}

// --- Suite Flow Bars (Diverging, NO $0 label) ---
function buildSuiteFlowBars(colors) {
  const container = document.getElementById('chart-suite-flows');
  const rect = container.getBoundingClientRect();
  const viewW = Math.round(rect.width);
  const viewH = Math.round(rect.height);
  if (viewW < 10 || viewH < 10) return;
  const svg = svgEl('svg', { viewBox: `0 0 ${viewW} ${viewH}`, preserveAspectRatio: 'none', width: '100%', height: '100%' });

  const maxFlow = Math.max(...SUITE_FLOWS.map(f => Math.abs(f.flows)));
  const L = 180, R = viewW - 70;  // wider left margin for suite names + value reserve
  // Value label reserves: positive side = up to ~55px, negative side = up to ~55px
  const VAL_RESERVE_NEG = 60;
  const VAL_RESERVE_POS = 55;
  // Decide centerX based on whether we have negative flows; if only positive, push center to left edge
  const hasNeg = SUITE_FLOWS.some(f => f.flows < 0);
  const hasPos = SUITE_FLOWS.some(f => f.flows > 0);
  let centerX;
  if (hasNeg && hasPos) {
    // Give both sides proportional room based on max magnitudes
    const maxPos = Math.max(0, ...SUITE_FLOWS.filter(f => f.flows > 0).map(f => f.flows));
    const maxNeg = Math.max(0, ...SUITE_FLOWS.filter(f => f.flows < 0).map(f => -f.flows));
    const totalMag = maxPos + maxNeg;
    const negFrac = totalMag > 0 ? maxNeg / totalMag : 0.5;
    centerX = L + VAL_RESERVE_NEG + (R - L - VAL_RESERVE_NEG - VAL_RESERVE_POS) * negFrac;
  } else if (hasNeg) {
    centerX = R - VAL_RESERVE_POS;  // all negative — put center on right
  } else {
    centerX = L + VAL_RESERVE_NEG;  // all positive — put center on left
  }
  const T = 6, barH = Math.min(16, Math.floor((viewH - T - 6) / SUITE_FLOWS.length) - 4), gap = 4;

  // Zero axis line (no label)
  svg.appendChild(svgEl('line', { x1: centerX, y1: T - 2, x2: centerX, y2: T + SUITE_FLOWS.length * (barH + gap), stroke: colors.grid, 'stroke-width': '1' }));

  // Available bar space on each side of centerX
  const posSpace = R - centerX - VAL_RESERVE_POS;
  const negSpace = centerX - L - VAL_RESERVE_NEG;

  SUITE_FLOWS.forEach((f, i) => {
    const y = T + i * (barH + gap);
    const isPos = f.flows >= 0;
    const barW = (Math.abs(f.flows) / maxFlow) * (isPos ? posSpace : negSpace);
    const color = isPos ? colors.positive : colors.negative;
    const x = isPos ? centerX : centerX - barW;

    svg.appendChild(svgEl('rect', { x: x, y: y, width: Math.max(barW, 2), height: barH, rx: 0, fill: color, opacity: '0.80' }));
    // Suite name anchored at left margin (never collides with bar since we reserve VAL_RESERVE_NEG px before bars start)
    svg.appendChild(svgEl('text', { x: L - 6, y: y + barH / 2 + 3, 'text-anchor': 'end', fill: colors.textPrimary, 'font-size': '9', 'font-weight': '600', 'font-family': FONT })).textContent = f.name;

    // Value label placed outside bar end, in reserved area
    const valX = isPos ? centerX + barW + 4 : centerX - barW - 4;
    const valAnchor = isPos ? 'start' : 'end';
    const valStr = isPos ? '+' + fmtDollar(f.flows) : fmtDollar(f.flows);
    svg.appendChild(svgEl('text', { x: valX, y: y + barH / 2 + 3, 'text-anchor': valAnchor, fill: color, 'font-size': '8', 'font-weight': '600', 'font-family': FONT })).textContent = valStr;
  });

  container.appendChild(svg);
}

// --- Family AUM Timeline (Area Chart) ---
// S5: % of suite AUM dashed line with right Y-axis
// Labels: all 13 monthly callouts identical, end-value label at right
// TREX_PCT, MICRO_PCT, EPI_PCT, GI_PCT are now computed from REPORT_DATA (see data constants section)

// EPI and G&I timeline data for buildFamilyTimeline
const EPI_TIMELINE = INCOME_TIMELINE.map(d => ({month: d.month, aum: d.epi}));
const GI_TIMELINE = INCOME_TIMELINE.map(d => ({month: d.month, aum: d.gi}));

function buildFamilyTimeline(containerId, dataKeyOrArray, color, colors, customPctData) {
  const container = document.getElementById(containerId);
  const rect = container.getBoundingClientRect();
  const viewW = Math.round(rect.width);
  const viewH = Math.round(rect.height);
  if (viewW < 10 || viewH < 10) return;
  const svg = svgEl('svg', { viewBox: `0 0 ${viewW} ${viewH}`, preserveAspectRatio: 'none', width: '100%', height: '100%' });

  const L = 48, R = viewW - 68, T = 14, B = viewH - 20;
  const W = R - L, H = B - T;

  let vals, months, n, pctData;
  if (typeof dataKeyOrArray === 'string') {
    n = DATA.length;
    vals = DATA.map(d => d[dataKeyOrArray] / 1e6);
    months = DATA.map(d => d.month);
    // S5: get % of suite AUM data
    if (dataKeyOrArray === 'trex') pctData = TREX_PCT;
    else if (dataKeyOrArray === 'micro') pctData = MICRO_PCT;
  } else {
    n = dataKeyOrArray.length;
    vals = dataKeyOrArray.map(d => d.aum / 1e6);
    months = dataKeyOrArray.map(d => d.month);
  }
  // Allow custom pctData override for EPI/GI
  if (customPctData) pctData = customPctData;

  const dataMax = Math.max(...vals);
  // Smart step: pick a nice round grid step based on data magnitude
  const rawStep = dataMax * 1.3 / 4; // aim for ~4 grid lines
  const magnitude = Math.pow(10, Math.floor(Math.log10(rawStep || 1)));
  const niceSteps = [1, 2, 5, 10];
  const step = magnitude * (niceSteps.find(s => s * magnitude >= rawStep) || 10);
  const yMax = Math.ceil(dataMax * 1.3 / step) * step || 200;
  const valToY = v => T + H - (v / yMax) * H;
  const idxToX = i => L + (i / (n - 1)) * W;

  // Right Y-axis for percentage (0-40%)
  const pctMax = 40;
  const pctToY = v => T + H - (v / pctMax) * H;

  // Grid lines — skip $0M label to avoid overlap with X-axis
  const gridStep = step;
  const yAxisLabelYs = [];
  for (let v = 0; v <= yMax; v += gridStep) {
    const y = valToY(v);
    svg.appendChild(svgEl('line', { x1: L, y1: y, x2: R, y2: y, stroke: colors.grid, 'stroke-width': '0.5' }));
    if (v > 0) {
      svg.appendChild(svgEl('text', { x: L - 4, y: y + 3, 'text-anchor': 'end', fill: colors.muted, 'font-size': '8', 'font-family': FONT })).textContent = '$' + v.toLocaleString() + 'M';
      yAxisLabelYs.push(y);
    }
  }

  // Right Y-axis labels for % (if pctData exists) — skip 0% and skip labels too close to data endpoint
  if (pctData) {
    const endValY = valToY(vals[n-1]);
    const endPctY = pctToY(pctData[n-1]);
    for (let v = 0; v <= pctMax; v += 10) {
      if (v === 0) continue; // skip 0% to avoid X-axis overlap
      const y = pctToY(v);
      // Skip if too close to the AUM end-value label or the % end-value label
      if (Math.abs(y - endValY) < 18 || Math.abs(y - endPctY) < 18) continue;
      svg.appendChild(svgEl('text', { x: R + 4, y: y + 3, 'text-anchor': 'start', fill: colors.muted, 'font-size': '8', 'font-family': FONT })).textContent = v + '%';
    }
  }

  // X-axis: show every month — 3-letter abbreviation, year only on first and last
  months.forEach((m, i) => {
    const d = new Date(m + 'T00:00:00');
    const mon = MONTHS_SHORT[d.getMonth()];
    const yr = "'" + String(d.getFullYear()).slice(2);
    const label = (i === 0 || i === n - 1) ? mon + ' ' + yr : mon;
    svg.appendChild(svgEl('text', { x: idxToX(i), y: B + 12, 'text-anchor': 'middle', fill: colors.muted, 'font-size': '8', 'font-family': FONT })).textContent = label;
  });

  // FIX 3: All suite timelines use consistent navy (#0c2340) for AUM line
  const aumColor = colors.series1; // Always navy for consistency

  // Area
  let areaPts = '';
  for (let i = 0; i < n; i++) areaPts += `${idxToX(i)},${valToY(vals[i])} `;
  areaPts += `${idxToX(n-1)},${valToY(0)} ${idxToX(0)},${valToY(0)}`;
  svg.appendChild(svgEl('polygon', { points: areaPts, fill: aumColor, opacity: '0.12' }));

  // Line
  let linePts = '';
  for (let i = 0; i < n; i++) linePts += `${idxToX(i)},${valToY(vals[i])} `;
  svg.appendChild(svgEl('polyline', { points: linePts, fill: 'none', stroke: aumColor, 'stroke-width': '2', 'stroke-linejoin': 'round' }));

  // Dots at every data point (small)
  for (let i = 0; i < n; i++) {
    svg.appendChild(svgEl('circle', { cx: idxToX(i), cy: valToY(vals[i]), r: 1.5, fill: aumColor }));
  }

  // S5: % of suite AUM dashed line (right Y-axis) — rendered BEFORE labels
  if (pctData && pctData.length === n) {
    let pctPts = '';
    for (let i = 0; i < n; i++) pctPts += `${idxToX(i)},${pctToY(pctData[i])} `;
    svg.appendChild(svgEl('polyline', { points: pctPts, fill: 'none', stroke: colors.accent, 'stroke-width': '1.5', 'stroke-dasharray': '6,3', 'stroke-linejoin': 'round' }));
    // End dot for % line
    svg.appendChild(svgEl('circle', { cx: idxToX(n-1), cy: pctToY(pctData[n-1]), r: 2, fill: colors.accent }));
  }

  // Deferred labels: collect ALL label elements, append LAST
  const deferredLabels = [];

  // End value label (font-size 10, positioned to the right)
  let endLabelY = valToY(vals[n-1]) + 4;
  const endText = '$' + Math.round(vals[n-1]).toLocaleString() + 'M';
  const endEstW = endText.length * 5.5 + 8;
  deferredLabels.push(svgEl('rect', { x: idxToX(n-1) + 6, y: endLabelY - 10, width: endEstW, height: 14, fill: '#ffffff', opacity: '0.90', rx: 2 }));
  const endEl = svgEl('text', { x: idxToX(n-1) + 6, y: endLabelY, 'text-anchor': 'start', fill: aumColor, 'font-size': '10', 'font-weight': '700', 'font-family': FONT });
  endEl.textContent = endText;
  deferredLabels.push(endEl);

  // % end label (deferred)
  if (pctData && pctData.length === n) {
    let pctEndY = pctToY(pctData[n-1]) + 3;
    if (Math.abs(pctEndY - endLabelY) < 18) {
      pctEndY = endLabelY + 18;
    }
    const pctText = pctData[n-1] + '%';
    const pctEstW = pctText.length * 5 + 8;
    deferredLabels.push(svgEl('rect', { x: idxToX(n-1) + 6, y: pctEndY - 10, width: pctEstW, height: 14, fill: '#ffffff', opacity: '0.90', rx: 2 }));
    const pctEl = svgEl('text', { x: idxToX(n-1) + 6, y: pctEndY, 'text-anchor': 'start', fill: colors.accent, 'font-size': '9', 'font-weight': '700', 'font-family': FONT });
    pctEl.textContent = pctText;
    deferredLabels.push(pctEl);
  }

  // Monthly value labels — ALL identical style (font-size 8, bold, white bg, ABOVE data point)
  for (let i = 0; i < n; i++) {
    if (i === n - 1) continue; // last index gets end-value label instead
    const mx = idxToX(i);
    let my = valToY(vals[i]) - 12;
    // Clamp if above top margin
    if (my < T) my = T + 4;
    // Offset UP if too close to a Y-axis gridline
    const tooCloseToGrid = yAxisLabelYs.some(gy => Math.abs(valToY(vals[i]) - gy) < 12);
    if (tooCloseToGrid) {
      my = my - 15;
      if (my < T) my = T + 4;
    }
    const labelText = '$' + Math.round(vals[i]).toLocaleString() + 'M';
    const estW = labelText.length * 4.5 + 6;
    const bgX = mx - estW / 2;
    deferredLabels.push(svgEl('rect', { x: bgX, y: my - 8, width: estW, height: 12, fill: '#ffffff', opacity: '0.90', rx: 2 }));
    const monthEl = svgEl('text', { x: mx, y: my, 'text-anchor': 'middle', fill: aumColor, 'font-size': '8', 'font-weight': '700', 'font-family': FONT });
    monthEl.textContent = labelText;
    deferredLabels.push(monthEl);
  }

  // Append ALL deferred labels LAST
  deferredLabels.forEach(el => svg.appendChild(el));

  // Y-axis titles (rotated)
  const leftTitle = svgEl('text', { x: 10, y: T + H/2, fill: colors.muted, 'font-size': '9', 'font-weight': '500', 'font-family': FONT, transform: `rotate(-90, 10, ${T + H/2})`, 'text-anchor': 'middle' });
  leftTitle.textContent = 'Asia AUM';
  svg.appendChild(leftTitle);

  if (pctData) {
    const rightTitle = svgEl('text', { x: R + 50, y: T + H/2, fill: colors.accent, 'font-size': '9', 'font-weight': '500', 'font-family': FONT, transform: `rotate(-90, ${R + 50}, ${T + H/2})`, 'text-anchor': 'middle' });
    rightTitle.textContent = '% of Suite';
    svg.appendChild(rightTitle);
  }

  container.appendChild(svg);
}

// buildIncomeTimeline removed — EPI and G&I now use buildFamilyTimeline

// --- Fund Tables (with % of Global AUM and % of Suite columns) ---
function buildFundTable(bodyId, funds, suiteName) {
  const body = document.getElementById(bodyId);
  const suiteTotal = funds.reduce((s, f) => s + f.aum, 0);
  funds.forEach(f => {
    const momStr = Math.abs(f.mom) > 9.99
      ? (f.mom > 0 ? '>999%' : '<-999%')
      : momSign(f.mom) + (f.mom*100).toFixed(1) + '%';
    const gMomStr = f.globalMom !== undefined
      ? (Math.abs(f.globalMom) > 9.99
        ? (f.globalMom > 0 ? '>999%' : '<-999%')
        : (f.globalMom >= 0 ? '+' : '') + (f.globalMom * 100).toFixed(1) + '%')
      : '-';
    const gMomClass = f.globalMom !== undefined ? momClass(f.globalMom) : 'neg-val';
    const asiaPct = f.total > 0 ? ((f.aum / f.total) * 100).toFixed(1) + '%' : '--';
    const priorAum = f.mom !== 0 ? f.aum / (1 + f.mom) : f.aum;
    const dollarChg = f.aum - priorAum;
    const marketMove = dollarChg - f.flows;
    const tr = document.createElement('tr');
    tr.innerHTML = `<td class="bold">${f.fund}</td><td class="r">${fmtDollar(f.aum)}</td>` +
      `<td class="r">${asiaPct}</td>` +
      `<td class="r"><span class="${momClass(marketMove)}">${momSign(marketMove)}${fmtDollar(Math.abs(marketMove))}</span></td>` +
      `<td class="r"><span class="${momClass(f.flows)}">${momSign(f.flows)}${fmtDollar(Math.abs(f.flows))}</span></td>` +
      `<td class="r"><span class="${momClass(f.mom)}">${momStr}</span></td>` +
      `<td class="r"><span class="${gMomClass}">${gMomStr}</span></td>`;
    body.appendChild(tr);
  });
}

// buildFundMomBars removed — replaced by Key Metrics strip
// buildGiTable removed — G&I now uses buildFundTable

// --- Appendix ---
function buildAppendix(colors) {
  const familyColors = {
    'T-REX': '#c93c37',
    'MicroSectors': '#1a7f37',
    'Equity Premium Income': '#0c2340',
    'Autocallable': '#0c2340',
    'Growth & Income': '#2c6fbb',
    'IncomeMax': '#2c6fbb',
    'Other': '#8c8c8c',
    'Crypto': '#8c8c8c'
  };
  // Appendix shows specific labels, not grouped names
  function appendixLabel(fund, groupFamily) {
    if (fund === 'ULTI') return 'IncomeMax';
    if (fund === 'ATCL') return 'Autocallable';
    if (groupFamily === 'EPI + Autocallable') return 'Equity Premium Income';
    if (groupFamily === 'G&I + IncomeMax') return 'Growth & Income';
    return groupFamily;
  }

  // Sort by AUM descending
  const appendixData = SUITE_FILTER ? APPENDIX.filter(f => f.family === SUITE_FILTER) : APPENDIX;
  const sorted = [...appendixData].sort((a, b) => b.aum - a.aum);
  const totalFunds = sorted.length;
  const PAGE1_MAX = 48;
  const page1Funds = sorted.slice(0, PAGE1_MAX);
  const page2Funds = sorted.slice(PAGE1_MAX);

  // Subtitle
  const suiteLabel = SUITE_FILTER ? SUITE_FILTER + ' funds' : 'REX funds';
  const subtitle = totalFunds + ' ' + suiteLabel + ' held in Asia \u2014 sorted by Asia AUM descending.' + (SUITE_FILTER ? '' : ' Not all REX products have Asia distribution.');
  const sub1 = document.getElementById('appendix-subtitle-1');
  if (sub1) sub1.textContent = subtitle;
  if (document.getElementById('appendix-subtitle-2')) {
    document.getElementById('appendix-subtitle-2').textContent = subtitle;
  }

  let sumAum = 0, sumTotal = 0, sumFlows = 0, sumMarketMove = 0, sumPrior = 0;

  function appendRows(bodyId, funds) {
    const body = document.getElementById(bodyId);
    if (!body) return;
    funds.forEach(f => {
      const tr = document.createElement('tr');
      const label = appendixLabel(f.fund, f.family);
      const fc = familyColors[label] || colors.muted;
      const priorAum = f.mom !== 0 ? f.aum / (1 + f.mom) : f.aum;
      const dollarChange = f.aum - priorAum;
      const marketMove = dollarChange - f.flows;
      const momPctStr = Math.abs(f.mom) > 9.99
        ? (f.mom > 0 ? '>999%' : '<-999%')
        : momSign(f.mom) + (f.mom * 100).toFixed(1) + '%';
      tr.innerHTML = `<td class="bold">${f.fund}</td>` +
        `<td><span style="color:${fc};font-weight:600;font-size:8.5px;">${label}</span></td>` +
        `<td class="r">${fmtDollar(f.aum)}</td><td class="r">${fmtDollar(f.total)}</td>` +
        `<td class="r">${fmtPct(f.pct)}</td>` +
        `<td class="r"><span class="${momClass(f.mom)}">${momPctStr}</span></td>` +
        `<td class="r"><span class="${momClass(marketMove)}">${momSign(marketMove)}${fmtDollar(Math.abs(marketMove))}</span></td>` +
        `<td class="r"><span class="${momClass(f.flows)}">${momSign(f.flows)}${fmtDollar(Math.abs(f.flows))}</span></td>`;
      body.appendChild(tr);
      sumAum += f.aum;
      sumTotal += f.total;
      sumFlows += f.flows;
      sumMarketMove += marketMove;
      sumPrior += priorAum;
    });
  }

  // Page 1
  appendRows('appendix-body', page1Funds);

  // Page 2
  if (page2Funds.length > 0) {
    appendRows('appendix-body-2', page2Funds);
  }

  // Non-Asia REX funds: total global AUM minus sum of global AUM for funds with Asia presence
  const _asiaFundsGlobal = REPORT_DATA.funds.reduce((s, f) => s + (f.asia_aum > 0 ? f.global_aum : 0), 0);
  const othersGlobal = REPORT_DATA.headlines.total_global_aum - _asiaFundsGlobal;
  const lastBodyId = page2Funds.length > 0 ? 'appendix-body-2' : 'appendix-body';
  const lastBody = document.getElementById(lastBodyId);

  // Others row — only in full report
  if (!SUITE_FILTER) {
    const trOthers = document.createElement('tr');
    trOthers.style.fontStyle = 'italic';
    trOthers.style.color = 'var(--text-muted)';
    trOthers.innerHTML = `<td>Others (non-Asia REX funds)</td><td></td>` +
      `<td class="r">$0</td><td class="r">${fmtDollar(othersGlobal)}</td>` +
      `<td class="r">0.0%</td><td class="r">\u2014</td>` +
      `<td class="r">\u2014</td><td class="r">\u2014</td>`;
    lastBody.appendChild(trOthers);
  }

  // Total row
  const grandTotal = SUITE_FILTER ? sumTotal : sumTotal + othersGlobal;
  const tr = document.createElement('tr');
  tr.className = 'total-row';
  tr.innerHTML = `<td>Total</td><td></td>` +
    `<td class="r">${fmtDollar(sumAum)}</td><td class="r">${fmtDollar(grandTotal)}</td>` +
    `<td class="r">${fmtPct(grandTotal > 0 ? sumAum / grandTotal : 0)}</td>` +
    `<td class="r">\u2014</td><td class="r">\u2014</td><td class="r">\u2014</td>`;
  lastBody.appendChild(tr);
}


// --- Country Distribution: 6-Month Horizontal Stacked Bars + Summary Table ---
// *_COUNTRY_6M and *_COUNTRY_SUMMARY are now computed from REPORT_DATA (see data constants section)

function buildCountryHzBars(containerId, monthData, countries) {
  const container = document.getElementById(containerId);
  if (!container) return;
  const rect = container.getBoundingClientRect();
  const viewW = Math.round(rect.width);
  const viewH = Math.round(rect.height);
  if (viewW < 10 || viewH < 10) return;

  const svg = svgEl('svg', { viewBox: '0 0 ' + viewW + ' ' + viewH, preserveAspectRatio: 'none', width: '100%', height: '100%' });

  // Reverse order: newest month on top — no legend (table to the right serves as legend)
  const reversed = [...monthData].reverse();
  const nBars = reversed.length;
  const labelMargin = 50;
  const totalBarSpace = viewH - 2;
  const gap = 3;
  const barH = Math.floor((totalBarSpace - (nBars - 1) * gap) / nBars);
  const barAreaTop = 0;
  const barAreaW = viewW - labelMargin - 2;

  // Draw 6 horizontal bars (newest first)
  for (var bi = 0; bi < nBars; bi++) {
    var by = barAreaTop + bi * (barH + gap);
    var pcts = reversed[bi].pcts;
    var mLabel = reversed[bi].month;

    // Month label left-aligned
    svg.appendChild(svgEl('text', {
      x: labelMargin - 4, y: by + barH / 2 + 3,
      'text-anchor': 'end', fill: '#5c5c5c',
      'font-size': '8', 'font-weight': '600', 'font-family': FONT
    })).textContent = mLabel;

    // Stacked segments left-to-right
    var segX = labelMargin;
    for (var si = 0; si < pcts.length; si++) {
      var segW = (pcts[si] / 100) * barAreaW;
      if (segW < 0.5) continue;
      svg.appendChild(svgEl('rect', { x: segX, y: by, width: segW, height: barH, fill: countries[si].color }));

      // Label inside segment if > 8% (enough width to be readable)
      if (pcts[si] > 8) {
        var labelEl = svg.appendChild(svgEl('text', {
          x: segX + segW / 2, y: by + barH / 2 + 3,
          'text-anchor': 'middle', fill: '#ffffff',
          'font-size': '7', 'font-weight': '700', 'font-family': FONT
        }));
        labelEl.textContent = pcts[si].toFixed(1) + '%';
      }
      segX += segW;
    }
  }

  container.appendChild(svg);
}

function buildCountrySummaryTable(containerId, summaryData, countries) {
  var container = document.getElementById(containerId);
  if (!container) return;

  // Build a color map — include both short and full country names
  var colorMap = {
    'Korea': '#0c2340', 'HK': '#c93c37', 'Hong Kong': '#c93c37',
    'Japan': '#2c6fbb', 'Other': '#b0b0b0',
    'Taiwan': '#b0b0b0', 'Singapore': '#b0b0b0', 'Malaysia': '#b0b0b0'
  };
  // Override with chart-specific country colors
  countries.forEach(function(c) { colorMap[c.name] = c.color; });

  var html = '<table style="width:100%;font-family:\'Times New Roman\',Times,serif;font-size:8px;border-collapse:collapse;margin-top:0;">';
  html += '<thead><tr style="border-bottom:1.5px solid #000;">';
  html += '<th style="text-align:left;padding:4px 6px;font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:#5c5c5c;">Country</th>';
  html += '<th style="text-align:right;padding:4px 6px;font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:#5c5c5c;">' + ((REPORT_DATA && REPORT_DATA.narrative && REPORT_DATA.narrative.month_short) ? REPORT_DATA.narrative.month_short : 'Month') + ' AUM ($M)</th>';
  html += '<th style="text-align:right;padding:4px 6px;font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:#5c5c5c;">Country Share (%)</th>';
  html += '</tr></thead><tbody>';

  summaryData.forEach(function(row, ri) {
    var bg = ri % 2 === 1 ? 'background:#f6f6f6;' : '';
    var swatch = colorMap[row.name] || '#b0b0b0';
    html += '<tr style="' + bg + '">';
    html += '<td style="padding:4px 6px;font-size:9px;"><span style="display:inline-block;width:7px;height:7px;background:' + swatch + ';border-radius:1px;margin-right:5px;vertical-align:middle;"></span>' + row.name + '</td>';
    html += '<td style="text-align:right;padding:4px 6px;font-size:9px;font-variant-numeric:tabular-nums;">$' + row.aum.toFixed(1) + '</td>';
    html += '<td style="text-align:right;padding:4px 6px;font-size:9px;font-variant-numeric:tabular-nums;">' + row.pct.toFixed(1) + '%</td>';
    html += '</tr>';
  });

  html += '</tbody></table>';
  container.innerHTML = html;
}


// ══════════════════════════════════════════════════════════════
// INIT
// ══════════════════════════════════════════════════════════════

window.addEventListener('DOMContentLoaded', () => {
  // Resolve CSS custom properties for SVG usage
  const cs = getComputedStyle(document.documentElement);
  const colors = {
    primary: cs.getPropertyValue('--primary').trim(),
    accent: cs.getPropertyValue('--accent').trim(),
    positive: cs.getPropertyValue('--positive').trim(),
    negative: cs.getPropertyValue('--negative').trim(),
    textPrimary: cs.getPropertyValue('--text-primary').trim(),
    textSecondary: cs.getPropertyValue('--text-secondary').trim(),
    muted: cs.getPropertyValue('--text-muted').trim(),
    rule: cs.getPropertyValue('--rule').trim(),
    grid: cs.getPropertyValue('--grid').trim(),
    series1: cs.getPropertyValue('--series-1').trim(),
    series2: cs.getPropertyValue('--series-2').trim(),
    series3: cs.getPropertyValue('--series-3').trim(),
    series4: cs.getPropertyValue('--series-4').trim()
  };

  // ── Populate all text from data ──
  (function populateText() {
    const h = REPORT_DATA.headlines;
    const s = REPORT_DATA.suites;
    const dc = h.dollar_change;
    const fl = h.total_flows;
    const mm = h.total_market_move;
    const momPct = h.mom_pct;

    // Helper: format to $XM or $X.XB
    function $m(v) { return fmtDollar(Math.abs(v)); }
    function $b(v) { return '$' + (Math.abs(v) / 1e9).toFixed(1) + 'B'; }
    function sign(v) { return v >= 0 ? '+' : '-'; }
    function signed$m(v) { return (v >= 0 ? '+' : '-') + $m(v); }
    function pct1(v) { return (v * 100).toFixed(1) + '%'; }

    // T-REX and MicroSectors suite data
    const trex = s['T-REX'];
    const micro = s['MicroSectors'];
    const trexMM = trex.market_move;
    const microMM = micro.market_move;
    const trexFL = trex.flows;
    const microFL = micro.flows;
    const trexPctAsia = trex.pct_in_asia;
    const microMoM = micro.mom;

    // Leveraged vs non-leveraged
    const leveragedAum = trex.aum + micro.aum;
    const nonLeveragedAum = h.total_asia_aum - leveragedAum;

    // ViewTrade (Taiwan + its HK + SG)
    const vt = (REPORT_DATA.fund_countries || []).filter(fc => {
      const ex = REPORT_DATA.exchanges.find(e => e.exchange.includes('ViewTrade') && e.country === fc.country);
      return !!ex;
    });
    // Actually just use exchanges data for ViewTrade total
    const vtExchanges = REPORT_DATA.exchanges.filter(e => e.exchange.includes('ViewTrade'));
    const vtTotal = vtExchanges.reduce((s, e) => s + e.aum, 0);

    // KSD share
    const ksd = REPORT_DATA.exchanges.find(e => e.exchange.includes('KSD'));
    const ksdPct = ksd ? (ksd.aum / h.total_asia_aum * 100).toFixed(0) : '70';

    // Top inflow fund
    const topInflow = APPENDIX.slice().sort((a, b) => b.flows - a.flows)[0];

    // --- Page 1 ---
    const el = id => document.getElementById(id);

    // Headline
    const flLabel = fl >= 0 ? 'inflows' : 'outflows';
    const mmLabel = mm >= 0 ? 'gains' : 'decline';
    const connector = (fl >= 0 && mm < 0) || (fl < 0 && mm >= 0) ? 'offset' : 'compounded by';
    el('p1-headline').textContent = `Asia AUM: ${$b(h.total_asia_aum)} \u2014 ${flLabel} (${signed$m(fl)}) ${connector} market ${mmLabel} (${signed$m(mm)})`;

    // KPIs
    el('kpi-asia-aum').textContent = $b(h.total_asia_aum);
    el('kpi-asia-mom').innerHTML = `<span class="${dc >= 0 ? 'pos-val' : 'neg-val'}">${signed$m(dc)}</span> <span class="${dc >= 0 ? 'pos-val' : 'neg-val'}">${pct1(momPct)}</span>`;
    el('kpi-global-aum').textContent = $b(h.total_global_aum);
    el('kpi-pct-asia').textContent = pct1(h.pct_in_asia);
    el('kpi-market-move').textContent = signed$m(mm);
    el('kpi-market-move').style.color = mm >= 0 ? 'var(--positive)' : 'var(--negative)';
    el('kpi-flows').textContent = signed$m(fl);
    el('kpi-flows').style.color = fl >= 0 ? 'var(--positive)' : 'var(--negative)';

    // Overview bullets
    // Overview bullets — tone/direction adapts to data sign
    const mmDir = mm >= 0
      ? '<strong>' + signed$m(mm) + '</strong> in market gains'
      : '<strong>' + signed$m(mm) + '</strong> in adverse movements';
    const flDir = fl >= 0
      ? ', partially offset by <strong>' + signed$m(fl) + '</strong> in est. net inflows'
      : ', compounded by <strong>' + signed$m(fl) + '</strong> in est. net outflows';
    const momDir = momPct >= 0 ? 'up' : 'down';
    const microTrend = microMoM >= 0
      ? 'gained <strong>' + sign(microMoM) + pct1(Math.abs(microMoM)) + ' MoM</strong>'
      : 'declined <strong>' + pct1(Math.abs(microMoM)) + ' MoM</strong>';
    const topFlowFund = APPENDIX.slice().sort((a, b) => Math.abs(b.flows) - Math.abs(a.flows))[0];
    const notableLine = topFlowFund
      ? '<strong>' + topFlowFund.fund + '</strong> ' + (topFlowFund.flows >= 0 ? 'attracted' : 'saw') + ' <strong>' + signed$m(topFlowFund.flows) + '</strong> in est. ' + (topFlowFund.flows >= 0 ? 'net inflows' : 'net outflows') + ' \u2014 the single largest Asia flow this month'
      : '';
    el('p1-overview').innerHTML = [
      '<li>Asia AUM: <strong>' + $b(h.total_asia_aum) + '</strong> across ' + h.country_count + ' markets and ' + h.exchange_count + ' exchanges \u2014 ' + momDir + ' <strong>' + pct1(Math.abs(momPct)) + ' MoM</strong> (' + signed$m(dc) + ')</li>',
      '<li>REX Shares (Leveraged): <strong>' + $b(leveragedAum) + '</strong> \u00b7 REX Financial (Non-Leveraged): <strong>' + $m(nonLeveragedAum) + '</strong></li>',
      '<li>Broad market ' + (mm >= 0 ? 'strength' : 'weakness') + ' drove ' + mmDir + flDir + '</li>',
      '<li><strong>T-REX</strong> represents <strong>' + pct1(trexPctAsia) + '</strong> of its global AUM in Asia; <strong>MicroSectors</strong> ' + microTrend + '</li>',
      notableLine ? '<li>' + notableLine + '</li>' : ''
    ].filter(Boolean).join('\n');

    // --- Page 2 ---
    el('p2-decline-title').textContent = `What Drove the ${$m(dc)} Decline?`;
    el('p2-mm-val').textContent = signed$m(mm);
    el('p2-fl-val').textContent = signed$m(fl);
    el('p2-mm-insight').innerHTML = `Broad equity selloff hit leveraged products hardest. T-REX declined <strong>${$m(trexMM)}</strong> from market moves alone; MicroSectors absorbed <strong>${$m(microMM)}</strong>.`;
    el('p2-fl-insight').innerHTML = `Strong investor conviction with est. <strong>${$m(trexFL)}</strong> flowing into T-REX and <strong>${$m(microFL)}</strong> into MicroSectors. ${topInflow ? topInflow.fund + ' alone attracted <strong>' + $m(topInflow.flows) + '</strong>.' : ''}`;

    const trexMicroFlows = trexFL + microFL;
    el('p2-exchange-subtitle').textContent = `${h.exchange_count} exchanges across ${h.country_count} markets \u2014 KSD Korea accounts for ${ksdPct}% of total Asia AUM`;
    el('p2-flows-subtitle').textContent = `T-REX and MicroSectors drove ${$m(trexMicroFlows)} of the ${$m(fl)} total est. net inflows`;

    // --- Country summaries on suite pages ---
    function countrySummaryText(data, maxShow) {
      if (!data || data.length === 0) return '';
      const shown = data.slice(0, maxShow || 3);
      const others = data.length - shown.length;
      const parts = shown.map(c => `${c.name} $${c.aum.toFixed(1)}M (${c.pct.toFixed(c.pct >= 10 ? 1 : 0)}%)`);
      if (others > 0) parts.push(`${others} other market${others > 1 ? 's' : ''}`);
      return parts.join(' \u00b7 ');
    }
    if (el('trex-country-summary')) el('trex-country-summary').textContent = countrySummaryText(TREX_COUNTRY_SUMMARY, 3);
    if (el('micro-country-summary')) el('micro-country-summary').textContent = countrySummaryText(MICRO_COUNTRY_SUMMARY, 2);
    if (el('epi-country-summary')) el('epi-country-summary').textContent = countrySummaryText(EPI_COUNTRY_SUMMARY, 3);
    if (el('gi-country-summary')) el('gi-country-summary').textContent = countrySummaryText(GI_COUNTRY_SUMMARY, 3);
  })();

  // Page 1
  buildSuiteStackedArea(colors);
  buildPctLineChart(colors);
  buildSuiteDonut(colors);
  buildSuiteTable();
  buildCountryTable();
  buildDonutChart(colors);

  // Month labels & suite-page overview bullets (data-driven from REPORT_DATA.narrative)
  (function renderNarrative() {
    const nar = (REPORT_DATA && REPORT_DATA.narrative) || {};
    // Replace static tokens in the rendered DOM
    const long = nar.month_long || 'Report Month';
    document.title = document.title.replace('__MONTH_LONG__', long);
    document.querySelectorAll('*').forEach(node => {
      if (node.children.length === 0 && node.textContent && node.textContent.indexOf('__MONTH_LONG__') !== -1) {
        node.textContent = node.textContent.replace(/__MONTH_LONG__/g, long);
      }
    });
    // Populate suite bullets if provided
    function setBullets(id, bullets) {
      const ul = document.getElementById(id);
      if (!ul || !bullets || !bullets.length) return;
      ul.innerHTML = bullets.map(b => `<li>${b}</li>`).join('\n');
    }
    setBullets('p3-overview', nar.trex_bullets);
    setBullets('p4-overview', nar.micro_bullets);
    setBullets('p5-overview', nar.epi_bullets);
    setBullets('p6-overview', nar.gi_bullets);
  })();

  // Page 2
  buildExchangeTable();
  buildSuiteFlowBars(colors);
  buildCountryStackedArea(colors);

  // Page 3 — T-REX (no donut)
  buildFamilyTimeline('chart-trex-aum', 'trex', colors.series1, colors);
  buildFundTable('trex-funds-body', TREX_TOP, 'T-REX');

  // Page 4 — MicroSectors (no donut)
  buildFamilyTimeline('chart-micro-aum', 'micro', colors.series2, colors);
  buildFundTable('micro-funds-body', MICRO_TOP, 'MicroSectors');

  // Page 5 — Equity Premium Income
  buildFamilyTimeline('chart-epi-aum', EPI_TIMELINE, colors.series3, colors, EPI_PCT);
  buildFundTable('epi-funds-body', PI_TOP, 'EPI');

  // Page 6 — G&I + IncomeMax
  buildFamilyTimeline('chart-gi-aum', GI_TIMELINE, colors.series4, colors, GI_PCT);
  buildFundTable('gi-funds-body', GI_TOP, 'G&I');

  // Country distribution horizontal bars + summary tables (pages 3-6)
  const countrySet4 = [
    {name:'Korea', color:'#0c2340'},
    {name:'HK', color:'#c93c37'},
    {name:'Japan', color:'#2c6fbb'},
    {name:'Other', color:'#b0b0b0'}
  ];
  const countrySetEPI = [
    {name:'Japan', color:'#2c6fbb'},
    {name:'Korea', color:'#0c2340'},
    {name:'HK', color:'#c93c37'},
    {name:'Other', color:'#b0b0b0'}
  ];
  const countrySetGI = [
    {name:'Korea', color:'#0c2340'},
    {name:'Japan', color:'#2c6fbb'},
    {name:'Singapore', color:'#c93c37'},
    {name:'Other', color:'#b0b0b0'}
  ];

  buildCountryHzBars('chart-trex-country-hz', TREX_COUNTRY_6M, countrySet4);
  buildCountrySummaryTable('table-trex-country-summary', TREX_COUNTRY_SUMMARY, countrySet4);

  buildCountryHzBars('chart-micro-country-hz', MICRO_COUNTRY_6M, countrySet4);
  buildCountrySummaryTable('table-micro-country-summary', MICRO_COUNTRY_SUMMARY, countrySet4);

  buildCountryHzBars('chart-epi-country-hz', EPI_COUNTRY_6M, countrySetEPI);
  buildCountrySummaryTable('table-epi-country-summary', EPI_COUNTRY_SUMMARY, countrySetEPI);

  buildCountryHzBars('chart-gi-country-hz', GI_COUNTRY_6M, countrySetGI);
  buildCountrySummaryTable('table-gi-country-summary', GI_COUNTRY_SUMMARY, countrySetGI);

  // Page 7 — Appendix
  buildAppendix(colors);

  // ══════════════════════════════════════════════════════════════
  // PER-FUND KPI RECALCULATION — replaces hardcoded suite KPIs
  // ══════════════════════════════════════════════════════════════
  function calcFromFunds(funds) {
    const aum = funds.reduce((s, f) => s + f.aum, 0);
    const globalAum = funds.reduce((s, f) => s + f.total, 0);
    const flows = funds.reduce((s, f) => s + f.flows, 0);
    let marketMove = 0;
    let priorAumTotal = 0;
    funds.forEach(f => {
      const prior = f.mom !== 0 ? f.aum / (1 + f.mom) : f.aum;
      priorAumTotal += prior;
      marketMove += (f.aum - prior) - f.flows;
    });
    const momDollar = aum - priorAumTotal;
    const momPct = priorAumTotal > 0 ? momDollar / priorAumTotal : 0;
    const pctInAsia = globalAum > 0 ? aum / globalAum : 0;
    // Prior month % in Asia (for pp-delta sub)
    let aumPrior = 0, globalAumPrior = 0;
    funds.forEach(f => {
      aumPrior += (f.aumPrior != null ? f.aumPrior : (f.aum - (f.flows || 0) - (f.marketMove || 0))) || 0;
      globalAumPrior += (f.globalPrior != null ? f.globalPrior : (f.global || 0)) || 0;
    });
    const pctInAsiaPrior = globalAumPrior > 0 ? aumPrior / globalAumPrior : 0;
    return { aum, globalAum, flows, marketMove, momDollar, momPct, pctInAsia, pctInAsiaPrior };
  }

  function updateSuiteKpis(pageIndex, funds, totalAsiaAum) {
    const page = document.querySelectorAll('.page')[pageIndex];
    if (!page) return;
    const k = calcFromFunds(funds);
    const kpis = page.querySelectorAll('.kpi-item');
    if (kpis.length < 5) return;

    // KPI 0: Asia AUM
    kpis[0].querySelector('.kpi-val').textContent = fmtDollar(k.aum);
    const sub0 = kpis[0].querySelector('.kpi-sub');
    if (sub0) sub0.textContent = (totalAsiaAum > 0 ? Math.round(k.aum / totalAsiaAum * 100) : 0) + '% of Asia total';

    // KPI 1: % in Asia (+ pp delta sub)
    kpis[1].querySelector('.kpi-val').textContent = (k.pctInAsia * 100).toFixed(1) + '%';
    const pp = (k.pctInAsia - k.pctInAsiaPrior) * 100;
    const sub1 = kpis[1].querySelector('.kpi-sub');
    if (sub1) {
      const ppSign = pp >= 0 ? '+' : '';
      sub1.textContent = ppSign + pp.toFixed(1) + 'pp';
      sub1.style.color = pp >= 0 ? 'var(--positive)' : 'var(--negative)';
    }

    // KPI 2: MoM Change
    const momVal = kpis[2].querySelector('.kpi-val');
    momVal.textContent = (k.momPct >= 0 ? '+' : '') + (k.momPct * 100).toFixed(1) + '%';
    momVal.style.color = k.momPct >= 0 ? 'var(--positive)' : 'var(--negative)';
    const sub2 = kpis[2].querySelector('.kpi-sub');
    if (sub2) sub2.innerHTML = '<span class="' + momClass(k.momDollar) + '">' +
      momSign(k.momDollar) + fmtDollar(Math.abs(k.momDollar)) + '</span>';

    // KPI 3: Est. Inflows
    const flowVal = kpis[3].querySelector('.kpi-val');
    flowVal.textContent = momSign(k.flows) + fmtDollar(Math.abs(k.flows));
    flowVal.style.color = k.flows >= 0 ? 'var(--positive)' : 'var(--negative)';

    // KPI 4: Market Move
    const mmVal = kpis[4].querySelector('.kpi-val');
    mmVal.textContent = (k.marketMove >= 0 ? '+' : '-') + fmtDollar(Math.abs(k.marketMove));
    mmVal.style.color = k.marketMove >= 0 ? 'var(--positive)' : 'var(--negative)';
  }

  // Total Asia AUM from APPENDIX
  const totalAsiaAum = APPENDIX.reduce((s, f) => s + f.aum, 0);

  // T-REX (page 2) — all T-REX funds from APPENDIX
  updateSuiteKpis(2, APPENDIX.filter(f => f.family === 'T-REX'), totalAsiaAum);

  // MicroSectors (page 3)
  updateSuiteKpis(3, APPENDIX.filter(f => f.family === 'MicroSectors'), totalAsiaAum);

  // EPI (page 4)
  updateSuiteKpis(4, APPENDIX.filter(f => f.family === 'EPI + Autocallable'), totalAsiaAum);

  // G&I + IncomeMax (page 5) — include ULTI which is family 'Other' but belongs on G&I page
  const giFunds = APPENDIX.filter(f => f.family === 'G&I + IncomeMax' || f.fund === 'ULTI');
  updateSuiteKpis(5, giFunds, totalAsiaAum);

  // ══════════════════════════════════════════════════════════════
  // SUITE FILTER — strip pages and modify content for suite-specific reports
  // ══════════════════════════════════════════════════════════════
  if (SUITE_FILTER) {
    const pages = Array.from(document.querySelectorAll('.page'));
    // Map: 0=Cover, 1=Distribution, 2=T-REX, 3=MicroSectors, 4=EPI, 5=G&I, 6=Appendix1, 7=Appendix2

    const suitePageIndex = SUITE_FILTER === 'T-REX' ? 2 : 3;

    // Remove: cover, distribution, all non-matching suite pages
    const removeIndices = [0, 1]; // Cover + Distribution
    [2, 3, 4, 5].forEach(i => { if (i !== suitePageIndex) removeIndices.push(i); });

    // Remove appendix page 2 if its body is empty
    const app2Body = document.getElementById('appendix-body-2');
    if (app2Body && app2Body.children.length === 0) removeIndices.push(7);

    // Keep methodology page (page 8, index 8) — don't remove it

    // Remove pages in reverse order
    removeIndices.sort((a, b) => b - a).forEach(i => { if (pages[i]) pages[i].remove(); });

    // --- Rebrand suite detail page as page 1 ---
    const suitePage = pages[suitePageIndex];
    const miniHeader = suitePage.querySelector('.mini-header');
    if (miniHeader) {
      // Replace mini-header with full header
      const header = document.createElement('div');
      header.className = 'header';
      header.innerHTML =
        '<div class="header-left">' +
          '<h1 style="font-size:22px;font-weight:700;color:#000;line-height:1.15;">' + SUITE_FILTER + ' Asia Report</h1>' +
          '<div class="desc" style="font-size:11px;color:#8c8c8c;margin-top:2px;">' + ((REPORT_DATA && REPORT_DATA.narrative && REPORT_DATA.narrative.month_long) || 'Report Month') + '</div>' +
        '</div>' +
        '<div class="header-right" style="text-align:right;">' +
          miniHeader.querySelector('.right').innerHTML +
        '</div>';
      // Enlarge logo on filtered report page 1
      const logoImg = header.querySelector('img');
      if (logoImg) logoImg.style.height = '38px';
      miniHeader.replaceWith(header);
    }

    // Remove "X% of Asia total" sub-text and "% in Asia" KPI (counterparties don't need these)
    const suiteKpis = suitePage.querySelectorAll('.kpi-item');
    suiteKpis.forEach(kpi => {
      const label = kpi.querySelector('.kpi-label');
      if (label) {
        if (label.textContent.trim() === '% in Asia') {
          kpi.remove();
          return;
        }
        if (label.textContent.trim() === 'Asia AUM') {
          const sub = kpi.querySelector('.kpi-sub');
          if (sub && sub.textContent.includes('of Asia total')) sub.remove();
        }
      }
    });
    // Re-space KPI strip from 5 to 4 columns
    const kpiStrip = suitePage.querySelector('.kpi-strip');
    if (kpiStrip) kpiStrip.style.gridTemplateColumns = 'repeat(4, 1fr)';

    // Update appendix page titles
    document.querySelectorAll('.page').forEach(p => {
      const title = p.querySelector('.title');
      if (title && title.textContent.includes('Appendix')) {
        title.textContent = 'Appendix \u2014 ' + SUITE_FILTER + ' Fund Detail';
      }
      if (title && title.textContent.includes('continued')) {
        title.textContent = 'Appendix \u2014 ' + SUITE_FILTER + ' Fund Detail (continued)';
      }
    });

    // Re-number page footers
    document.querySelectorAll('.page').forEach((p, i) => {
      const footer = p.querySelector('.footer');
      if (footer) {
        const spans = footer.querySelectorAll('span');
        spans.forEach(sp => {
          if (sp.textContent.includes('Page')) {
            sp.textContent = 'REX Financial \u00B7 Page ' + (i + 1);
          }
        });
      }
    });
  }
});
</script>

</body>
</html>