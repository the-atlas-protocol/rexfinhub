<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>REX Asia Report — __MONTH_LONG__</title>
<style>
@page { size: letter; margin: 0; }
:root {
  --primary: #000000;
  --accent: #2c6fbb;
  --positive: #1a7f37;
  --negative: #c93c37;
  --text-primary: #1a1a1a;
  --text-secondary: #5c5c5c;
  --text-muted: #8c8c8c;
  --rule: #d4d4d4;
  --grid: #ebebeb;
  --alt-row: #f6f6f6;
  --series-1: #0c2340;
  --series-2: #2c6fbb;
  --series-3: #7a7a7a;
  --series-4: #b0b0b0;
}
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Times New Roman', Times, serif;
  background: #ffffff;
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}
@media print {
  * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
}

svg { display: block; }

.page {
  width: 8.5in;
  height: 11in;
  padding: 0.5in 0.6in 0.4in 0.6in;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  background: #ffffff;
  page-break-after: always;
}
.page:last-child { page-break-after: auto; }

/* --- Header (Page 1) --- */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-bottom: 3px;
  border-bottom: 1.5px solid var(--primary);
  flex-shrink: 0;
}
.header-left h1 {
  font-size: 22px;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.15;
}
.header-left .desc {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 2px;
}
.header-right {
  text-align: right;
  flex-shrink: 0;
}
.header-right .firm {
  font-weight: 700;
  font-size: 12px;
  color: var(--primary);
}
.header-right .date {
  font-size: 10px;
  color: var(--text-muted);
  margin-top: 1px;
}

.header img, .header-right img, .mini-header img, .mini-header .right img {
  height: 38px !important;
  width: auto !important;
}
.header, .mini-header {
  align-items: flex-end !important;
}
.mini-header .right, .header-right {
  align-items: flex-end !important;
  align-self: flex-end;
}

/* --- Mini Header (pages 2+) --- */
.mini-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-bottom: 3px;
  border-bottom: 1.5px solid var(--primary);
  flex-shrink: 0;
  margin-bottom: 8px;
}
.mini-header .title {
  font-weight: 700;
  font-size: 14px;
  color: var(--primary);
}
.mini-header .right {
  font-size: 8px;
  color: var(--text-muted);
}

/* --- Section Heading --- */
.section-heading {
  padding-bottom: 4px;
  border-bottom: 1px solid #d4d4d4;
  margin-bottom: 6px;
  margin-top: 14px;
  flex-shrink: 0;
}
.section-heading:first-child,
.section-heading.no-top-margin {
  margin-top: 0;
}
.section-heading.first-section {
  margin-top: 8px;
}
.section-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.3;
}
.section-subtitle {
  font-size: 10px;
  color: var(--text-secondary);
  line-height: 1.3;
}

/* --- Rule --- */
.rule {
  border: none;
  border-top: 1px solid var(--rule);
  margin: 8px 0;
  flex-shrink: 0;
}

/* --- KPI Strip --- */
.kpi-strip {
  display: flex;
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  margin-bottom: 8px;
  flex-shrink: 0;
}
.kpi-item {
  flex: 1;
  padding: 7px 10px 6px;
  border-right: 1px solid var(--rule);
  background: none;
  border-top: none;
  border-bottom: none;
  border-left: none;
  box-shadow: none;
}
.kpi-item:last-child { border-right: none; }
.kpi-label {
  font-size: 8px;
  font-weight: 600;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 2px;
}
.kpi-val {
  font-size: 24px;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.kpi-val.small { font-size: 20px; }
.kpi-sub {
  font-size: 9px;
  color: var(--text-muted);
  margin-top: 1px;
}

/* --- Tables --- */
.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 9px;
  font-variant-numeric: tabular-nums;
}
.data-table th {
  font-size: 8px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  color: var(--text-secondary);
  text-align: left;
  padding: 4px 6px;
  border-bottom: 1.5px solid var(--primary);
}
.data-table th.r { text-align: right; }
.data-table td {
  padding: 3.5px 6px;
  color: var(--text-primary);
}
.data-table td.r { text-align: right; font-variant-numeric: tabular-nums; }
.data-table td.bold { font-weight: 600; color: var(--primary); }
.data-table tbody tr:nth-child(even) td { background: var(--alt-row); }
.data-table .total-row td {
  font-weight: 700;
  color: var(--primary);
  border-top: 1.5px solid var(--primary);
}
.pos-val { color: var(--positive); font-weight: 600; }
.neg-val { color: var(--negative); font-weight: 600; }

/* --- Layout helpers --- */
.two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  align-items: stretch;
}
.col-30-70 {
  display: grid;
  grid-template-columns: 35% 65%;
  gap: 10px;
  align-items: center;
}
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; min-height: 0; }

/* --- Legend --- */
.legend-row {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 3px;
  font-size: 8px;
  color: var(--text-muted);
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 4px;
}
.legend-swatch {
  width: 16px;
  height: 2px;
}

/* --- Insight text --- */
.insight {
  font-size: 9.5px;
  line-height: 1.5;
  color: var(--text-primary);
}
.insight strong { color: var(--primary); }

/* --- Bullets --- */
.obs-list, .key-obs {
  font-size: 9px;
  line-height: 1.5;
  color: #1a1a1a;
  padding-left: 16px;
  margin: 0;
  margin-top: 8px;
  list-style-type: disc;
  font-family: 'Times New Roman', Times, serif;
}
.obs-list li, .key-obs li { margin-bottom: 2px; }


/* --- Country Summary (replaces donuts on suite pages) --- */
.country-summary {
  font-size: 9px;
  color: #5c5c5c;
  margin-bottom: 8px;
  padding-bottom: 6px;
  border-bottom: 1px solid #ebebeb;
}

/* --- Footer --- */
.footer {
  display: flex;
  justify-content: space-between;
  font-size: 8px;
  color: var(--text-muted);
  border-top: 1px solid var(--rule);
  padding-top: 5px;
  margin-top: auto;
  flex-shrink: 0;
}
</style>
</head>
<body>

<!-- PAGE 1: OVERVIEW -->
<div class="page">
  <div class="header">
    <div class="header-left">
      <h1>REX Asia Report</h1>
      <div class="desc">__MONTH_LONG__</div>
    </div>
    <div class="header-right">
      <img src="data:image/png;base64," alt="REX Financial" style="height: 22px; display: block; margin-left: auto;">
    </div>
  </div>

  <div style="font-size: 8px; color: #8c8c8c; margin-top: 4px; margin-bottom: 2px; letter-spacing: 0.3px;">
    Overview &middot; Market Activity &amp; Flows &middot; T-REX &middot; MicroSectors &middot; Equity Premium Income &middot; Growth &amp; Income &middot; Appendix
  </div>

  <!-- Takeaway -->
  <div id="p1-headline" style="font-size: 13px; font-weight: 600; color: var(--primary); margin: 8px 0 4px; line-height: 1.4;">
  </div>

  <!-- KPI Strip — 5 items -->
  <div class="kpi-strip">
    <div class="kpi-item">
      <div class="kpi-label">Total Asian AUM</div>
      <div id="kpi-asia-aum" class="kpi-val small"></div>
      <div id="kpi-asia-mom" class="kpi-sub"></div>
    </div>
    <div class="kpi-item">
      <div class="kpi-label">Total REX AUM</div>
      <div id="kpi-global-aum" class="kpi-val small"></div>
    </div>
    <div class="kpi-item">
      <div class="kpi-label">% of AUM in Asia</div>
      <div id="kpi-pct-asia" class="kpi-val small"></div>
    </div>
    <div class="kpi-item">
      <div class="kpi-label">Market Move</div>
      <div id="kpi-market-move" class="kpi-val small"></div>
    </div>
    <div class="kpi-item">
      <div class="kpi-label">Est. Monthly Flows*</div>
      <div id="kpi-flows" class="kpi-val small"></div>
    </div>
  </div>
  <div style="font-size: 9px; color: #5c5c5c; margin-bottom: 6px;">
  </div>

  <!-- Overview -->
  <div style="background: #f8f8f8; border-left: 3px solid #d4d4d4; padding: 8px 12px; margin-top: 6px; margin-bottom: 10px; font-size: 9px; line-height: 1.6; color: #1a1a1a;">
    <div style="font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #000; margin-bottom: 4px;">Overview</div>
    <ul id="p1-overview" style="margin: 0; padding-left: 14px; list-style-type: disc;">
    </ul>
  </div>

  <!-- Two charts side by side -->
  <div class="two-col" style="gap: 10px;">
    <div class="flex-col">
      <div class="section-heading no-top-margin">
        <div class="section-title" style="font-size: 12px;">Asia AUM by Product Suite</div>
      </div>
      <div class="legend-row" style="font-size: 8px;">
        <div class="legend-item"><div class="legend-swatch" style="background: var(--series-1);"></div>T-REX</div>
        <div class="legend-item"><div class="legend-swatch" style="background: var(--series-2);"></div>MicroSectors</div>
        <div class="legend-item"><div class="legend-swatch" style="background: var(--series-3);"></div>Other</div>
      </div>
      <div id="chart-suite-stacked" style="height: 170px;"></div>
    </div>
    <div class="flex-col">
      <div class="section-heading no-top-margin">
        <div class="section-title" style="font-size: 12px;">% of AUM in Asia</div>
        <div class="section-subtitle"></div>
      </div>
      <div id="chart-pct-line" style="height: 185px;"></div>
    </div>
  </div>
  <hr class="rule">

  <!-- Product Suite Breakdown -->
  <div class="section-heading no-top-margin">
    <div class="section-title" style="font-size: 12px;">Product Suite Breakdown</div>
  </div>
  <div style="display: grid; grid-template-columns: 35% 1fr; gap: 10px; align-items: center;">
    <div id="chart-suite-donut" style="height: 160px;"></div>
    <div style="overflow: hidden; max-width: 100%; min-width: 0;">
      <table class="data-table" style="font-size: 8.5px; table-layout: fixed; width: 100%;">
        <colgroup>
          <col style="width: 32%;">
          <col style="width: 24%;">
          <col style="width: 24%;">
          <col style="width: 20%;">
        </colgroup>
        <thead><tr><th>Suite</th><th class="r">AUM</th><th class="r">% of Total</th><th class="r">MoM</th></tr></thead>
        <tbody id="suite-table-body"></tbody>
      </table>
    </div>
  </div>
  <hr class="rule">

  <!-- Country Breakdown -->
  <div class="section-heading no-top-margin">
    <div class="section-title" style="font-size: 12px;">Country Breakdown</div>
  </div>
  <div style="display: grid; grid-template-columns: 35% 1fr; gap: 10px; align-items: center;">
    <div id="chart-donut" style="height: 160px;"></div>
    <div style="overflow: hidden; max-width: 100%; min-width: 0;">
      <table class="data-table" style="font-size: 8.5px; table-layout: fixed; width: 100%;">
        <colgroup>
          <col style="width: 32%;">
          <col style="width: 24%;">
          <col style="width: 24%;">
          <col style="width: 20%;">
        </colgroup>
        <thead><tr><th>Country</th><th class="r">AUM</th><th class="r">% of Total</th><th class="r">MoM</th></tr></thead>
        <tbody id="country-table-body"></tbody>
      </table>
    </div>
  </div>

  <div class="footer">
    <span>Source: Bloomberg, broker reports, 13F filings. *Flow estimates derived from shares outstanding and NAV data; actual fund flows may differ.</span>
    <span>REX Financial · Page 1</span>
  </div>
</div>


<!-- PAGE 2: DISTRIBUTION & FLOWS -->
<div class="page">
  <div class="mini-header">
    <div class="title">Market Activity & Est. Flows*</div>
    <div class="right" style="display: flex; align-items: center; gap: 8px;"><img src="data:image/png;base64," alt="REX" style="height: 14px;"></div>
  </div>

  <!-- Flow Decomposition -->
  <div class="section-heading no-top-margin">
    <div id="p2-decline-title" class="section-title" style="font-size: 12px;"></div>
  </div>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 6px;">
    <div>
      <div id="p2-mm-val" style="font-size: 20px; font-weight: 700; color: var(--negative); margin-bottom: 3px;"></div>
      <div class="kpi-label" style="margin-bottom: 3px;">Market Impact</div>
      <div id="p2-mm-insight" class="insight"></div>
    </div>
    <div>
      <div id="p2-fl-val" style="font-size: 20px; font-weight: 700; color: var(--positive); margin-bottom: 3px;"></div>
      <div class="kpi-label" style="margin-bottom: 3px;">Est. Net Inflows*</div>
      <div id="p2-fl-insight" class="insight"></div>
    </div>
  </div>
  <hr class="rule">

  <!-- Exchange Table -->
  <div class="section-heading no-top-margin">
    <div class="section-title" style="font-size: 12px;">Exchange Breakdown — Top 10</div>
    <div id="p2-exchange-subtitle" class="section-subtitle"></div>
  </div>
  <table class="data-table" style="margin-bottom: 6px;">
    <thead><tr><th>Exchange</th><th>Country</th><th class="r">Products</th><th class="r">AUM</th><th class="r">% of Asia</th></tr></thead>
    <tbody id="exchange-table-body"></tbody>
  </table>
  <hr class="rule">

  <!-- Net Flows by Suite -->
  <div class="section-heading no-top-margin">
    <div class="section-title" style="font-size: 12px;">Est. Net Flows* by Product Suite</div>
    <div id="p2-flows-subtitle" class="section-subtitle"></div>
  </div>
  <div id="chart-suite-flows" style="height: 130px; margin-bottom: 6px;"></div>
  <hr class="rule">

  <!-- Country AUM Over Time (moved from page 1) -->
  <div class="section-heading no-top-margin">
    <div class="section-title" style="font-size: 12px;">Country AUM Over Time</div>
  </div>
  <div class="legend-row" style="font-size: 8px;">
    <div class="legend-item"><div class="legend-swatch" style="background: var(--series-1);"></div>Korea</div>
    <div class="legend-item"><div class="legend-swatch" style="background: var(--negative);"></div>Hong Kong</div>
    <div class="legend-item"><div class="legend-swatch" style="background: var(--series-2);"></div>Japan</div>
    <div class="legend-item"><div class="legend-swatch" style="background: var(--text-muted);"></div>Other</div>
  </div>
  <div id="chart-country-stacked" style="flex: 1; min-height: 0;"></div>

  <div class="footer">
    <span>Source: Bloomberg, broker reports, 13F filings. *Flow estimates derived from shares outstanding and NAV data; actual fund flows may differ.</span>
    <span>REX Financial · Page 2</span>
  </div>
</div>


<!-- PAGE 3: T-REX -->
<div class="page">
  <div class="mini-header">
    <div class="title">T-REX Leveraged ETFs</div>
    <div class="right" style="display: flex; align-items: center; gap: 8px;"><img src="data:image/png;base64," alt="REX" style="height: 14px;"></div>
  </div>

  <div class="kpi-strip" style="display: grid; grid-template-columns: repeat(5, 1fr);">
    <div class="kpi-item">
      <div class="kpi-label">Asia AUM</div>
      <div class="kpi-val small">$699M</div>
      <div class="kpi-sub">53% of Asia total</div>
    </div>
    <div class="kpi-item">
      <div class="kpi-label">% in Asia</div>
      <div class="kpi-val small">35.7%</div>
      <div class="kpi-sub" style="color: var(--positive); font-weight: 600;">+5.1pp</div>
    </div>
    <div class="kpi-item">
      <div class="kpi-label">MoM Change</div>
      <div class="kpi-val small" style="color: var(--negative);">-9.2%</div>
      <div class="kpi-sub"><span class="neg-val">-$71.0M</span></div>
    </div>
    <div class="kpi-item">
      <div class="kpi-label">Est. Inflows*</div>
      <div class="kpi-val small" style="color: var(--positive);">+$160M</div>
    </div>
    <div class="kpi-item">
      <div class="kpi-label">Market Move</div>
      <div class="kpi-val small" style="color: var(--negative);">-$231M</div>
    </div>
  </div>

  <div style="background: #f8f8f8; border-left: 3px solid #d4d4d4; padding: 8px 12px; margin-top: 6px; margin-bottom: 10px; font-size: 9px; line-height: 1.6; color: #1a1a1a;">
    <div style="font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #000; margin-bottom: 4px;">Overview</div>
    <ul id="p3-overview" style="margin: 0; padding-left: 14px; list-style-type: disc;"></ul>
  </div>

  <div class="section-heading no-top-margin" style="margin-top: 10px;">
    <div class="section-title" style="font-size: 12px;">T-REX Asia AUM Timeline</div>
    <div class="section-subtitle">13-month trend</div>
  </div>
  <div id="chart-trex-aum" style="height: 200px; margin-bottom: 10px;"></div>
  <hr class="rule">

  <!-- Country summary + full-width fund table (donut removed) -->
  <div class="section-heading no-top-margin" style="margin-top: 10px;">
    <div class="section-title" style="font-size: 12px;">T-REX Top 8 Funds</div>
  </div>
  <div id="trex-country-summary" class="country-summary"></div>
  <table class="data-table">
    <thead><tr><th>Fund</th><th class="r">Asia AUM</th><th class="r">% of Global AUM</th><th class="r">Market Move</th><th class="r">Est. Flows*</th><th class="r">Asia MoM</th><th class="r">Global MoM</th></tr></thead>
    <tbody id="trex-funds-body"></tbody>
  </table>
  <hr class="rule">

  <div class="section-heading no-top-margin" style="margin-top: 10px;">
    <div class="section-title" style="font-size: 12px;">Asia Country Distribution</div>
  </div>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; align-items: start; min-width: 0;">
    <div id="chart-trex-country-hz" style="height: 130px;"></div>
    <div id="table-trex-country-summary" style="min-width:0;overflow:hidden;"></div>
  </div>
  <div class="footer">
    <span>Source: Bloomberg, broker reports, 13F filings. *Flow estimates derived from shares outstanding and NAV data; actual fund flows may differ.</span>
    <span>REX Financial · Page 3</span>
  </div>
</div>


<!-- PAGE 4: MICROSECTORS -->
<div class="page">
  <div class="mini-header">
    <div class="title">MicroSectors ETNs</div>
    <div class="right" style="display: flex; align-items: center; gap: 8px;"><img src="data:image/png;base64," alt="REX" style="height: 14px;"></div>
  </div>

  <div class="kpi-strip" style="display: grid; grid-template-columns: repeat(5, 1fr);">
    <div class="kpi-item">
      <div class="kpi-label">Asia AUM</div>
      <div class="kpi-val small">$489M</div>
      <div class="kpi-sub">37% of Asia total</div>
    </div>
    <div class="kpi-item">
      <div class="kpi-label">% in Asia</div>
      <div class="kpi-val small">15.5%</div>
      <div class="kpi-sub" style="color: var(--positive); font-weight: 600;">+0.8pp</div>
    </div>
    <div class="kpi-item">
      <div class="kpi-label">MoM Change</div>
      <div class="kpi-val small" style="color: var(--positive);">+3.5%</div>
      <div class="kpi-sub"><span class="pos-val">+$17.0M</span></div>
    </div>
    <div class="kpi-item">
      <div class="kpi-label">Est. Inflows*</div>
      <div class="kpi-val small" style="color: var(--positive);">+$137M</div>
    </div>
    <div class="kpi-item">
      <div class="kpi-label">Market Move</div>
      <div class="kpi-val small" style="color: var(--negative);">-$120M</div>
    </div>
  </div>

  <div style="background: #f8f8f8; border-left: 3px solid #d4d4d4; padding: 8px 12px; margin-top: 6px; margin-bottom: 10px; font-size: 9px; line-height: 1.6; color: #1a1a1a;">
    <div style="font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #000; margin-bottom: 4px;">Overview</div>
    <ul id="p4-overview" style="margin: 0; padding-left: 14px; list-style-type: disc;"></ul>
  </div>

  <div class="section-heading no-top-margin" style="margin-top: 10px;">
    <div class="section-title" style="font-size: 12px;">MicroSectors Asia AUM Timeline</div>
    <div class="section-subtitle">13-month trend</div>
  </div>
  <div id="chart-micro-aum" style="height: 200px; margin-bottom: 10px;"></div>
  <hr class="rule">

  <!-- Country summary + full-width fund table (donut removed) -->
  <div class="section-heading no-top-margin" style="margin-top: 10px;">
