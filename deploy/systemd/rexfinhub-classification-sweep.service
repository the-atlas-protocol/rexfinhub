[Unit]
Description=REX FinHub Morning Classification Sweep — surfaces NULL etp_category / issuer_display gaps before the send-day rush
After=network-online.target
Wants=network-online.target

# Audit 2026-06-09: failures must page, not rot in journalctl.
OnFailure=rexfinhub-alert@%n.service

[Service]
Type=oneshot
User=jarvis
WorkingDirectory=/home/jarvis/rexfinhub
EnvironmentFile=/home/jarvis/rexfinhub/config/.env
# Pin process timezone to ET (audit fix R7).
Environment=TZ=America/New_York
ExecStartPre=-/usr/bin/git -C /home/jarvis/rexfinhub pull --ff-only origin main
# Engine session 2026-06-09: classify autonomously FIRST (tiers: rulings ->
# rules -> LLM+critic -> queue; docs/CLASSIFICATION.md), then report. The '-'
# tolerates an LLM-API hiccup so the sweep report still goes out.
ExecStart=-/home/jarvis/venv/bin/python scripts/classify_daily.py --apply
# Stamp this morning's decisions onto mkt_master_data immediately (don't
# wait for the 17:15 chain) — idempotent, seconds.
ExecStart=-/home/jarvis/venv/bin/python scripts/apply_fund_master.py
# Stage D (approved plan) — silence by default: classification still runs, but the
# routine "here are the gaps" email is dropped (--post-summary removed). The
# self-healing cascade auto-resolves most gaps and logs them; only the chain's single
# "reports ready / needs your call" message reaches Ryu. Run without --post-summary so
# the sweep still records gaps to disk/queue without emailing.
ExecStart=/home/jarvis/venv/bin/python scripts/classification_sweep.py
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
