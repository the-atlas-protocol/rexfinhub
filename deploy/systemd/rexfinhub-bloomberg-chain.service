[Unit]
Description=REX FinHub Bloomberg Pull, Sync, Apply Overrides Chain
# This service supersedes rexfinhub-bloomberg.service for scheduled runs.
# It runs the same Bloomberg pull + sync, then applies manual overrides so
# that hand-corrected values are not reverted by nightly Bloomberg resync.
# The original rexfinhub-bloomberg.service is kept for ad-hoc one-shot use.

[Service]
Type=oneshot
User=jarvis
WorkingDirectory=/home/jarvis/rexfinhub
EnvironmentFile=/home/jarvis/rexfinhub/config/.env
# Pin process timezone to ET (audit fix R7).
Environment=TZ=America/New_York
Environment="PATH=/home/jarvis/venv/bin:/usr/bin:/bin"
ExecStart=/home/jarvis/venv/bin/python -c "from webapp.services.graph_files import download_bloomberg_from_sharepoint; from webapp.database import init_db, SessionLocal; from webapp.services.market_sync import sync_market_data; download_bloomberg_from_sharepoint(); init_db(); db=SessionLocal(); sync_market_data(db); db.close(); print('Bloomberg pull + sync complete')"
# Phase 1 (ADR 0003): 4 ExecStartPost lines consolidated into one wrapper
# script for fewer moving parts + single place for logging/timing.
ExecStartPost=/home/jarvis/venv/bin/python /home/jarvis/rexfinhub/scripts/apply_bloomberg_post_steps.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
