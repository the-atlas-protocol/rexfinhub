[Unit]
Description=REX FinHub Morning Triage (assertion run + summary email)
# Phase 6 Stages 5+6 (ADR 0009): replaces the 20:15 ET pipeline_summary
# with an 08:00 ET assertion-driven triage email. Runs after overnight
# Bloomberg sync + classification settle.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jarvis
WorkingDirectory=/home/jarvis/rexfinhub
EnvironmentFile=/home/jarvis/rexfinhub/config/.env
Environment=TZ=America/New_York
# Run the 10-assertion suite, then send the triage summary email.
# Both scripts are idempotent (running multiple times in a day is harmless;
# each writes a new run_at row to assertion_run).
ExecStart=/home/jarvis/venv/bin/python /home/jarvis/rexfinhub/scripts/run_assertions.py
ExecStartPost=/home/jarvis/venv/bin/python /home/jarvis/rexfinhub/scripts/morning_triage_email.py
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
